[
  {
    "id": "guanju",
    "title": "关雎",
    "author": "《诗经》",
    "dynasty": "先秦",
    "type": "poem",
    "term": "八下",
    "level": "中考必背",
    "no": 1,
    "unit": "八下 课标必背",
    "paras": [
      {
        "text": "关关雎鸠，在河之洲。窈窕淑女，君子好逑。",
        "pinyin": [
          { "w": "雎鸠", "p": "jū jiū" },
          { "w": "窈窕", "p": "yǎo tiǎo" },
          { "w": "好逑", "p": "hǎo qiú" }
        ],
        "keys": ["关关雎鸠", "河之洲", "窈窕淑女", "君子好逑"]
      },
      {
        "text": "参差荇菜，左右流之。窈窕淑女，寤寐求之。",
        "pinyin": [
          { "w": "参差", "p": "cēn cī" },
          { "w": "荇菜", "p": "xìng cài" },
          { "w": "寤寐", "p": "wù mèi" }
        ],
        "keys": ["参差荇菜", "左右流之", "窈窕淑女", "寤寐求之"]
      },
      {
        "text": "求之不得，寤寐思服。悠哉悠哉，辗转反侧。",
        "pinyin": [
          { "w": "寤寐", "p": "wù mèi" },
          { "w": "辗转", "p": "zhǎn zhuǎn" }
        ],
        "keys": ["求之不得", "寤寐思服", "悠哉悠哉", "辗转反侧"]
      },
      {
        "text": "参差荇菜，左右采之。窈窕淑女，琴瑟友之。",
        "pinyin": [
          { "w": "参差", "p": "cēn cī" },
          { "w": "荇菜", "p": "xìng cài" },
          { "w": "琴瑟", "p": "qín sè" }
        ],
        "keys": ["参差荇菜", "左右采之", "窈窕淑女", "琴瑟友之"]
      },
      {
        "text": "参差荇菜，左右芼之。窈窕淑女，钟鼓乐之。",
        "pinyin": [
          { "w": "荇菜", "p": "xìng cài" },
          { "w": "芼", "p": "mào" },
          { "w": "参差", "p": "cēn cī" }
        ],
        "keys": ["参差荇菜", "左右芼之", "窈窕淑女", "钟鼓乐之"]
      }
    ]
  },
  {
    "id": "jianjia",
    "title": "蒹葭",
    "author": "《诗经》",
    "dynasty": "先秦",
    "type": "poem",
    "term": "八下",
    "level": "中考必背",
    "no": 2,
    "unit": "八下 课标必背",
    "paras": [
      {
        "text": "蒹葭苍苍，白露为霜。所谓伊人，在水一方。溯洄从之，道阻且长。溯游从之，宛在水中央。",
        "pinyin": [
          { "w": "蒹葭", "p": "jiān jiā" },
          { "w": "苍苍", "p": "cāng cāng" },
          { "w": "溯洄", "p": "sù huí" }
        ],
        "keys": ["蒹葭苍苍", "白露为霜", "在水一方", "溯洄从之", "水中央"]
      },
      {
        "text": "蒹葭萋萋，白露未晞。所谓伊人，在水之湄。溯洄从之，道阻且跻。溯游从之，宛在水中坻。",
        "pinyin": [
          { "w": "蒹葭", "p": "jiān jiā" },
          { "w": "晞", "p": "xī" },
          { "w": "湄", "p": "méi" },
          { "w": "跻", "p": "jī" },
          { "w": "坻", "p": "chí" }
        ],
        "keys": ["蒹葭萋萋", "白露未晞", "在水之湄", "道阻且跻", "水中坻"]
      },
      {
        "text": "蒹葭采采，白露未已。所谓伊人，在水之涘。溯洄从之，道阻且右。溯游从之，宛在水中沚。",
        "pinyin": [
          { "w": "蒹葭", "p": "jiān jiā" },
          { "w": "涘", "p": "sì" },
          { "w": "沚", "p": "zhǐ" }
        ],
        "keys": ["蒹葭采采", "白露未已", "在水之涘", "道阻且右", "水中沚"]
      }
    ]
  },
  {
    "id": "songdushaofu",
    "title": "送杜少府之任蜀州",
    "author": "王勃",
    "dynasty": "唐",
    "type": "poem",
    "term": "八下",
    "level": "中考必背",
    "no": 7,
    "unit": "八下 课标必背",
    "paras": [
      {
        "text": "城阙辅三秦，风烟望五津。与君离别意，同是宦游人。",
        "pinyin": [
          { "w": "城阙", "p": "chéng què" },
          { "w": "五津", "p": "wǔ jīn" },
          { "w": "宦游", "p": "huàn yóu" }
        ],
        "keys": ["城阙辅三秦", "风烟望五津", "与君离别意", "宦游人"]
      },
      {
        "text": "海内存知己，天涯若比邻。无为在歧路，儿女共沾巾。",
        "pinyin": [
          { "w": "天涯", "p": "tiān yá" },
          { "w": "歧路", "p": "qí lù" },
          { "w": "沾巾", "p": "zhān jīn" }
        ],
        "keys": ["海内存知己", "天涯若比邻", "无为在歧路", "儿女共沾巾"]
      }
    ]
  },
  {
    "id": "maowuweifeng",
    "title": "茅屋为秋风所破歌",
    "author": "杜甫",
    "dynasty": "唐",
    "type": "poem",
    "term": "八下",
    "level": "中考必背",
    "no": 16,
    "unit": "八下 课标必背",
    "paras": [
      {
        "text": "八月秋高风怒号，卷我屋上三重茅。茅飞渡江洒江郊，高者挂罥长林梢，下者飘转沉塘坳。",
        "pinyin": [
          { "w": "怒号", "p": "nù háo" },
          { "w": "三重", "p": "sān chóng" },
          { "w": "挂罥", "p": "guà juàn" },
          { "w": "沉塘坳", "p": "chén táng āo" }
        ],
        "keys": ["八月秋高", "风怒号", "三重茅", "挂罥长林梢", "沉塘坳"]
      },
      {
        "text": "南村群童欺我老无力，忍能对面为盗贼。公然抱茅入竹去，唇焦口燥呼不得，归来倚杖自叹息。",
        "pinyin": [
          { "w": "盗贼", "p": "dào zéi" },
          { "w": "唇焦口燥", "p": "chún jiāo kǒu zào" },
          { "w": "倚杖", "p": "yǐ zhàng" }
        ],
        "keys": ["南村群童", "老无力", "对面为盗贼", "唇焦口燥", "倚杖自叹息"]
      },
      {
        "text": "俄顷风定云墨色，秋天漠漠向昏黑。布衾多年冷似铁，娇儿恶卧踏里裂。床头屋漏无干处，雨脚如麻未断绝。自经丧乱少睡眠，长夜沾湿何由彻！",
        "pinyin": [
          { "w": "俄顷", "p": "é qǐng" },
          { "w": "布衾", "p": "bù qīn" },
          { "w": "恶卧", "p": "è wò" },
          { "w": "丧乱", "p": "sāng luàn" },
          { "w": "何由彻", "p": "hé yóu chè" }
        ],
        "keys": ["俄顷风定", "云墨色", "布衾多年", "娇儿恶卧", "床头屋漏", "长夜沾湿"]
      },
      {
        "text": "安得广厦千万间，大庇天下寒士俱欢颜！风雨不动安如山。呜呼！何时眼前突兀见此屋，吾庐独破受冻死亦足！",
        "pinyin": [
          { "w": "广厦", "p": "guǎng shà" },
          { "w": "大庇", "p": "dà bì" },
          { "w": "突兀", "p": "tū wù" },
          { "w": "呜呼", "p": "wū hū" }
        ],
        "keys": ["广厦千万间", "大庇天下", "寒士俱欢颜", "风雨不动", "吾庐独破"]
      }
    ]
  },
  {
    "id": "maitanweng",
    "title": "卖炭翁",
    "author": "白居易",
    "dynasty": "唐",
    "type": "poem",
    "term": "八下",
    "level": "中考必背",
    "no": 19,
    "unit": "八下 课标必背",
    "paras": [
      {
        "text": "卖炭翁，伐薪烧炭南山中。满面尘灰烟火色，两鬓苍苍十指黑。",
        "pinyin": [
          { "w": "伐薪", "p": "fá xīn" },
          { "w": "两鬓", "p": "liǎng bìn" },
          { "w": "烟火色", "p": "yān huǒ sè" }
        ],
        "keys": ["卖炭翁", "伐薪烧炭", "满面尘灰", "两鬓苍苍", "十指黑"]
      },
      {
        "text": "卖炭得钱何所营？身上衣裳口中食。可怜身上衣正单，心忧炭贱愿天寒。",
        "pinyin": [
          { "w": "何所营", "p": "hé suǒ yíng" },
          { "w": "衣裳", "p": "yī shang" },
          { "w": "炭贱", "p": "tàn jiàn" }
        ],
        "keys": ["卖炭得钱", "何所营", "身上衣裳", "衣正单", "心忧炭贱", "愿天寒"]
      },
      {
        "text": "夜来城外一尺雪，晓驾炭车辗冰辙。牛困人饥日已高，市南门外泥中歇。",
        "pinyin": [
          { "w": "辗", "p": "niǎn" },
          { "w": "冰辙", "p": "bīng zhé" },
          { "w": "牛困人饥", "p": "niú kùn rén jī" }
        ],
        "keys": ["夜来城外", "一尺雪", "晓驾炭车", "辗冰辙", "牛困人饥", "泥中歇"]
      },
      {
        "text": "翩翩两骑来是谁？黄衣使者白衫儿。手把文书口称敕，回车叱牛牵向北。",
        "pinyin": [
          { "w": "翩翩", "p": "piān piān" },
          { "w": "敕", "p": "chì" },
          { "w": "叱牛", "p": "chì niú" }
        ],
        "keys": ["翩翩两骑", "黄衣使者", "白衫儿", "口称敕", "回车叱牛"]
      },
      {
        "text": "一车炭，千余斤，宫使驱将惜不得。半匹红纱一丈绫，系向牛头充炭直。",
        "pinyin": [
          { "w": "宫使", "p": "gōng shǐ" },
          { "w": "驱将", "p": "qū jiāng" },
          { "w": "绫", "p": "líng" },
          { "w": "炭直", "p": "tàn zhí" }
        ],
        "keys": ["一车炭", "千余斤", "宫使驱将", "惜不得", "红纱", "一丈绫"]
      }
    ]
  },
  {
    "id": "zhuangzi",
    "title": "《庄子》一则（北冥有鱼）",
    "author": "《庄子》",
    "dynasty": "先秦",
    "type": "wenyan",
    "term": "八下",
    "level": "中考必背",
    "no": 44,
    "unit": "八下 课标必背",
    "paras": [
      {
        "text": "北冥有鱼，其名为鲲。鲲之大，不知其几千里也；化而为鸟，其名为鹏。",
        "pinyin": [
          { "w": "北冥", "p": "běi míng" },
          { "w": "鲲", "p": "kūn" }
        ],
        "keys": ["北冥有鱼", "其名为鲲", "不知其几千里也", "其名为鹏"]
      },
      {
        "text": "鹏之背，不知其几千里也；怒而飞，其翼若垂天之云。是鸟也，海运则将徙于南冥。南冥者，天池也。",
        "pinyin": [
          { "w": "垂天", "p": "chuí tiān" },
          { "w": "徙", "p": "xǐ" },
          { "w": "南冥", "p": "nán míng" }
        ],
        "keys": ["鹏之背", "怒而飞", "垂天之云", "海运", "南冥"]
      },
      {
        "text": "《齐谐》者，志怪者也。《谐》之言曰：“鹏之徙于南冥也，水击三千里，抟扶摇而上者九万里，去以六月息者也。”",
        "pinyin": [
          { "w": "齐谐", "p": "qí xié" },
          { "w": "抟扶摇", "p": "tuán fú yáo" },
          { "w": "六月息", "p": "liù yuè xī" }
        ],
        "keys": ["齐谐", "志怪者也", "水击三千里", "抟扶摇", "九万里", "六月息"]
      },
      {
        "text": "野马也，尘埃也，生物之以息相吹也。天之苍苍，其正色邪？其远而无所至极邪？其视下也，亦若是则已矣。",
        "pinyin": [
          { "w": "尘埃", "p": "chén āi" },
          { "w": "正色邪", "p": "zhèng sè yé" },
          { "w": "至极", "p": "zhì jí" }
        ],
        "keys": ["野马", "尘埃", "相吹", "天之苍苍", "正色邪", "亦若是则已矣"]
      }
    ]
  },
  {
    "id": "liji",
    "title": "《礼记》一则（虽有嘉肴）",
    "author": "《礼记》",
    "dynasty": "先秦",
    "type": "wenyan",
    "term": "八下",
    "level": "中考必背",
    "no": 45,
    "unit": "八下 课标必背",
    "paras": [
      {
        "text": "虽有嘉肴，弗食，不知其旨也；虽有至道，弗学，不知其善也。",
        "pinyin": [
          { "w": "嘉肴", "p": "jiā yáo" },
          { "w": "弗食", "p": "fú shí" },
          { "w": "旨", "p": "zhǐ" }
        ],
        "keys": ["虽有嘉肴", "弗食", "不知其旨也", "虽有至道", "不知其善也"]
      },
      {
        "text": "是故学然后知不足，教然后知困。知不足，然后能自反也；知困，然后能自强也。",
        "pinyin": [
          { "w": "自反", "p": "zì fǎn" },
          { "w": "自强", "p": "zì qiáng" },
          { "w": "知困", "p": "zhī kùn" }
        ],
        "keys": ["学然后知不足", "教然后知困", "自反", "自强"]
      },
      {
        "text": "故曰：教学相长也。《兑命》曰“学学半”，其此之谓乎！",
        "pinyin": [
          { "w": "教学相长", "p": "jiào xué xiāng zhǎng" },
          { "w": "兑命", "p": "yuè mìng" },
          { "w": "学学半", "p": "xiào xué bàn" }
        ],
        "keys": ["教学相长", "兑命", "学学半", "其此之谓乎"]
      }
    ]
  },
  {
    "id": "taohuayuanji",
    "title": "桃花源记",
    "author": "陶渊明",
    "dynasty": "东晋",
    "type": "wenyan",
    "term": "八下",
    "level": "中考必背",
    "no": 49,
    "unit": "八下 课标必背",
    "paras": [
      {
        "text": "晋太元中，武陵人捕鱼为业。缘溪行，忘路之远近。忽逢桃花林，夹岸数百步，中无杂树，芳草鲜美，落英缤纷。渔人甚异之。复前行，欲穷其林。",
        "pinyin": [
          { "w": "武陵", "p": "wǔ líng" },
          { "w": "缘溪", "p": "yuán xī" },
          { "w": "夹岸", "p": "jiā àn" },
          { "w": "缤纷", "p": "bīn fēn" },
          { "w": "欲穷", "p": "yù qióng" }
        ],
        "keys": ["武陵人", "缘溪行", "忽逢桃花林", "芳草鲜美", "落英缤纷", "欲穷其林"]
      },
      {
        "text": "林尽水源，便得一山，山有小口，仿佛若有光。便舍船，从口入。初极狭，才通人。复行数十步，豁然开朗。土地平旷，屋舍俨然，有良田、美池、桑竹之属。阡陌交通，鸡犬相闻。其中往来种作，男女衣着，悉如外人。黄发垂髫，并怡然自乐。",
        "pinyin": [
          { "w": "豁然", "p": "huò rán" },
          { "w": "俨然", "p": "yǎn rán" },
          { "w": "阡陌", "p": "qiān mò" },
          { "w": "垂髫", "p": "chuí tiáo" },
          { "w": "舍船", "p": "shě chuán" },
          { "w": "衣着", "p": "yī zhuó" }
        ],
        "keys": ["林尽水源", "豁然开朗", "土地平旷", "屋舍俨然", "阡陌交通", "黄发垂髫"]
      },
      {
        "text": "见渔人，乃大惊，问所从来。具答之。便要还家，设酒杀鸡作食。村中闻有此人，咸来问讯。自云先世避秦时乱，率妻子邑人来此绝境，不复出焉，遂与外人间隔。问今是何世，乃不知有汉，无论魏晋。此人一一为具言所闻，皆叹惋。余人各复延至其家，皆出酒食。停数日，辞去。此中人语云：“不足为外人道也。”",
        "pinyin": [
          { "w": "要", "p": "yāo" },
          { "w": "邑人", "p": "yì rén" },
          { "w": "遂", "p": "suì" },
          { "w": "间隔", "p": "jiàn gé" },
          { "w": "语云", "p": "yù yún" },
          { "w": "叹惋", "p": "tàn wǎn" }
        ],
        "keys": ["便要还家", "咸来问讯", "邑人来此绝境", "遂与外人间隔", "不知有汉", "不足为外人道也"]
      },
      {
        "text": "既出，得其船，便扶向路，处处志之。及郡下，诣太守，说如此。太守即遣人随其往，寻向所志，遂迷，不复得路。",
        "pinyin": [
          { "w": "诣", "p": "yì" },
          { "w": "遂迷", "p": "suì mí" },
          { "w": "志之", "p": "zhì zhī" }
        ],
        "keys": ["便扶向路", "处处志之", "诣太守", "寻向所志", "遂迷", "不复得路"]
      },
      {
        "text": "南阳刘子骥，高尚士也，闻之，欣然规往。未果，寻病终。后遂无问津者。",
        "pinyin": [
          { "w": "子骥", "p": "zǐ jì" },
          { "w": "规往", "p": "guī wǎng" },
          { "w": "问津", "p": "wèn jīn" }
        ],
        "keys": ["南阳刘子骥", "欣然规往", "未果", "寻病终", "问津者"]
      }
    ]
  },
  {
    "id": "mashuo",
    "title": "马说（杂说四）",
