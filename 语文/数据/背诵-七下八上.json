          { "w": "早莺", "p": "zǎo yīng" },
          { "w": "啄春泥", "p": "zhuó chūn ní" }
        ],
        "keys": ["孤山寺北", "贾亭西", "水面初平", "早莺争暖树", "新燕啄春泥"]
      },
      {
        "text": "乱花渐欲迷人眼，浅草才能没马蹄。最爱湖东行不足，绿杨阴里白沙堤。",
        "pinyin": [
          { "w": "没马蹄", "p": "mò mǎ tí" },
          { "w": "绿杨", "p": "lǜ yáng" },
          { "w": "白沙堤", "p": "bái shā dī" }
        ],
        "keys": ["乱花渐欲", "迷人眼", "浅草才能", "行不足", "白沙堤"]
      }
    ]
  },
  {
