          { "w": "萋萋", "p": "qī qī" },
          { "w": "鹦鹉洲", "p": "yīng wǔ zhōu" },
          { "w": "乡关", "p": "xiāng guān" }
        ],
        "keys": ["晴川历历", "汉阳树", "芳草萋萋", "鹦鹉洲", "使人愁"]
      }
    ]
  },
  {
