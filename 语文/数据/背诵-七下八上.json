          { "w": "殷勤", "p": "yīn qín" }
        ],
        "keys": ["天接云涛", "连晓雾", "星河欲转", "千帆舞", "梦魂归帝所", "归何处"]
      },
      {
        "text": "我报路长嗟日暮，学诗谩有惊人句。九万里风鹏正举。风休住，蓬舟吹取三山去！",
        "pinyin": [
          { "w": "路长", "p": "lù cháng" },
          { "w": "嗟", "p": "jiē" },
          { "w": "谩有", "p": "màn yǒu" },
          { "w": "鹏正举", "p": "péng zhèng jǔ" },
          { "w": "蓬舟", "p": "péng zhōu" }
        ],
        "keys": ["路长嗟日暮", "谩有惊人句", "风鹏正举", "风休住", "三山去"]
      }
    ]
  },
  {
