[
  {
    "id": "mulan",
    "title": "木兰诗",
    "author": "北朝民歌",
    "dynasty": "南北朝",
    "type": "poem",
    "term": "七下",
    "level": "中考必背",
    "no": 6,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "唧唧复唧唧，木兰当户织。不闻机杼声，惟闻女叹息。",
        "pinyin": [
          { "w": "唧唧", "p": "jī jī" },
          { "w": "机杼", "p": "jī zhù" },
          { "w": "惟闻", "p": "wéi wén" }
        ],
        "keys": ["唧唧复唧唧", "木兰当户织", "不闻机杼声", "女叹息"]
      },
      {
        "text": "问女何所思，问女何所忆。女亦无所思，女亦无所忆。昨夜见军帖，可汗大点兵，军书十二卷，卷卷有爷名。阿爷无大儿，木兰无长兄，愿为市鞍马，从此替爷征。",
        "pinyin": [
          { "w": "军帖", "p": "jūn tiě" },
          { "w": "可汗", "p": "kè hán" },
          { "w": "鞍马", "p": "ān mǎ" }
        ],
        "keys": ["何所思", "何所忆", "可汗大点兵", "卷卷有爷名", "愿为市鞍马", "替爷征"]
      },
      {
        "text": "东市买骏马，西市买鞍鞯，南市买辔头，北市买长鞭。旦辞爷娘去，暮宿黄河边，不闻爷娘唤女声，但闻黄河流水鸣溅溅。旦辞黄河去，暮至黑山头，不闻爷娘唤女声，但闻燕山胡骑鸣啾啾。",
        "pinyin": [
          { "w": "鞍鞯", "p": "ān jiān" },
          { "w": "辔头", "p": "pèi tóu" },
          { "w": "溅溅", "p": "jiān jiān" },
          { "w": "胡骑", "p": "hú jì" },
          { "w": "啾啾", "p": "jiū jiū" }
        ],
        "keys": ["东市买骏马", "西市买鞍鞯", "南市买辔头", "北市买长鞭", "鸣溅溅", "鸣啾啾"]
      },
      {
        "text": "万里赴戎机，关山度若飞。朔气传金柝，寒光照铁衣。将军百战死，壮士十年归。",
        "pinyin": [
          { "w": "戎机", "p": "róng jī" },
          { "w": "朔气", "p": "shuò qì" },
          { "w": "金柝", "p": "jīn tuò" },
          { "w": "铁衣", "p": "tiě yī" }
        ],
        "keys": ["万里赴戎机", "关山度若飞", "朔气传金柝", "寒光照铁衣", "将军百战死", "壮士十年归"]
      },
      {
        "text": "归来见天子，天子坐明堂。策勋十二转，赏赐百千强。可汗问所欲，木兰不用尚书郎，愿驰千里足，送儿还故乡。",
        "pinyin": [
          { "w": "策勋", "p": "cè xūn" },
          { "w": "十二转", "p": "shí èr zhuǎn" },
          { "w": "百千强", "p": "bǎi qiān qiáng" }
        ],
        "keys": ["归来见天子", "策勋十二转", "赏赐百千强", "可汗问所欲", "尚书郎", "还故乡"]
      },
      {
        "text": "爷娘闻女来，出郭相扶将；阿姊闻妹来，当户理红妆；小弟闻姊来，磨刀霍霍向猪羊。开我东阁门，坐我西阁床，脱我战时袍，著我旧时裳。当窗理云鬓，对镜帖花黄。出门看火伴，火伴皆惊忙：同行十二年，不知木兰是女郎。",
        "pinyin": [
          { "w": "扶将", "p": "fú jiāng" },
          { "w": "阿姊", "p": "ā zǐ" },
          { "w": "霍霍", "p": "huò huò" },
          { "w": "著我旧时裳", "p": "zhuó wǒ jiù shí cháng" },
          { "w": "云鬓", "p": "yún bìn" },
          { "w": "帖花黄", "p": "tiē huā huáng" },
          { "w": "火伴", "p": "huǒ bàn" }
        ],
        "keys": ["出郭相扶将", "磨刀霍霍", "著我旧时裳", "当窗理云鬓", "对镜帖花黄", "木兰是女郎"]
      },
      {
        "text": "雄兔脚扑朔，雌兔眼迷离；双兔傍地走，安能辨我是雄雌？",
        "pinyin": [
          { "w": "扑朔", "p": "pū shuò" },
          { "w": "迷离", "p": "mí lí" },
          { "w": "傍地走", "p": "bàng dì zǒu" }
        ],
        "keys": ["脚扑朔", "眼迷离", "傍地走", "辨我是雄雌"]
      }
    ]
  },
  {
    "id": "dengyouzhoutai",
    "title": "登幽州台歌",
    "author": "陈子昂",
    "dynasty": "唐",
    "type": "poem",
    "term": "七下",
    "level": "中考必背",
    "no": 8,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "前不见古人，后不见来者。念天地之悠悠，独怆然而涕下！",
        "pinyin": [
          { "w": "怆然", "p": "chuàng rán" },
          { "w": "涕下", "p": "tì xià" }
        ],
        "keys": ["前不见古人", "后不见来者", "天地之悠悠", "独怆然而涕下"]
      }
    ]
  },
  {
    "id": "wangyue",
    "title": "望岳",
    "author": "杜甫",
    "dynasty": "唐",
    "type": "poem",
    "term": "七下",
    "level": "中考必背",
    "no": 14,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "岱宗夫如何？齐鲁青未了。造化钟神秀，阴阳割昏晓。",
        "pinyin": [
          { "w": "岱宗", "p": "dài zōng" },
          { "w": "夫如何", "p": "fú rú hé" },
          { "w": "青未了", "p": "qīng wèi liǎo" },
          { "w": "造化", "p": "zào huà" }
        ],
        "keys": ["岱宗夫如何", "齐鲁青未了", "造化钟神秀", "阴阳割昏晓"]
      },
      {
        "text": "荡胸生曾云，决眦入归鸟。会当凌绝顶，一览众山小。",
        "pinyin": [
          { "w": "曾云", "p": "céng yún" },
          { "w": "决眦", "p": "jué zì" },
          { "w": "凌绝顶", "p": "líng jué dǐng" }
        ],
        "keys": ["荡胸生曾云", "决眦入归鸟", "会当凌绝顶", "一览众山小"]
      }
    ]
  },
  {
    "id": "boqinhuai",
    "title": "泊秦淮",
    "author": "杜牧",
    "dynasty": "唐",
    "type": "poem",
    "term": "七下",
    "level": "中考必背",
    "no": 23,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "烟笼寒水月笼沙，夜泊秦淮近酒家。",
        "pinyin": [
          { "w": "烟笼", "p": "yān lǒng" },
          { "w": "月笼沙", "p": "yuè lǒng shā" },
          { "w": "秦淮", "p": "qín huái" }
        ],
        "keys": ["烟笼寒水", "月笼沙", "夜泊秦淮", "近酒家"]
      },
      {
        "text": "商女不知亡国恨，隔江犹唱后庭花。",
        "pinyin": [
          { "w": "商女", "p": "shāng nǚ" },
          { "w": "后庭花", "p": "hòu tíng huā" }
        ],
        "keys": ["商女", "亡国恨", "隔江犹唱", "后庭花"]
      }
    ]
  },
  {
    "id": "dengfeilaifeng",
    "title": "登飞来峰",
    "author": "王安石",
    "dynasty": "宋",
    "type": "poem",
    "term": "七下",
    "level": "中考必背",
    "no": 29,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "飞来山上千寻塔，闻说鸡鸣见日升。",
        "pinyin": [
          { "w": "千寻塔", "p": "qiān xún tǎ" },
          { "w": "闻说", "p": "wén shuō" }
        ],
        "keys": ["飞来山上", "千寻塔", "鸡鸣见日升"]
      },
      {
        "text": "不畏浮云遮望眼，自缘身在最高层。",
        "pinyin": [
          { "w": "不畏", "p": "bù wèi" },
          { "w": "自缘", "p": "zì yuán" }
        ],
        "keys": ["不畏浮云", "遮望眼", "身在最高层"]
      }
    ]
  },
  {
    "id": "youshanxicun",
    "title": "游山西村",
    "author": "陆游",
    "dynasty": "宋",
    "type": "poem",
    "term": "七下",
    "level": "中考必背",
    "no": 33,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "莫笑农家腊酒浑，丰年留客足鸡豚。山重水复疑无路，柳暗花明又一村。",
        "pinyin": [
          { "w": "腊酒", "p": "là jiǔ" },
          { "w": "鸡豚", "p": "jī tún" },
          { "w": "山重水复", "p": "shān chóng shuǐ fù" }
        ],
        "keys": ["腊酒浑", "足鸡豚", "山重水复", "柳暗花明"]
      },
      {
        "text": "箫鼓追随春社近，衣冠简朴古风存。从今若许闲乘月，拄杖无时夜叩门。",
        "pinyin": [
          { "w": "箫鼓", "p": "xiāo gǔ" },
          { "w": "春社", "p": "chūn shè" },
          { "w": "拄杖", "p": "zhǔ zhàng" },
          { "w": "叩门", "p": "kòu mén" }
        ],
        "keys": ["箫鼓追随", "春社近", "衣冠简朴", "闲乘月", "拄杖无时", "夜叩门"]
      }
    ]
  },
  {
    "id": "jihaizashi",
    "title": "己亥杂诗（其五）",
    "author": "龚自珍",
    "dynasty": "清",
    "type": "poem",
    "term": "七下",
    "level": "中考必背",
    "no": 39,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "浩荡离愁白日斜，吟鞭东指即天涯。",
        "pinyin": [
          { "w": "浩荡", "p": "hào dàng" },
          { "w": "白日斜", "p": "bái rì xiá" },
          { "w": "吟鞭", "p": "yín biān" }
        ],
        "keys": ["浩荡离愁", "白日斜", "吟鞭东指", "即天涯"]
      },
      {
        "text": "落红不是无情物，化作春泥更护花。",
        "pinyin": [
          { "w": "落红", "p": "luò hóng" },
          { "w": "春泥", "p": "chūn ní" }
        ],
        "keys": ["落红", "无情物", "化作春泥", "更护花"]
      }
    ]
  },
  {
    "id": "loushiming",
    "title": "陋室铭",
    "author": "刘禹锡",
    "dynasty": "唐",
    "type": "wenyan",
    "term": "七下",
    "level": "中考必背",
    "no": 53,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "山不在高，有仙则名。水不在深，有龙则灵。斯是陋室，惟吾德馨。",
        "pinyin": [
          { "w": "陋室", "p": "lòu shì" },
          { "w": "德馨", "p": "dé xīn" }
        ],
        "keys": ["有仙则名", "有龙则灵", "斯是陋室", "惟吾德馨"]
      },
      {
        "text": "苔痕上阶绿，草色入帘青。谈笑有鸿儒，往来无白丁。可以调素琴，阅金经。无丝竹之乱耳，无案牍之劳形。",
        "pinyin": [
          { "w": "苔痕", "p": "tái hén" },
          { "w": "鸿儒", "p": "hóng rú" },
          { "w": "调素琴", "p": "tiáo sù qín" },
          { "w": "案牍", "p": "àn dú" }
        ],
        "keys": ["苔痕上阶绿", "草色入帘青", "谈笑有鸿儒", "往来无白丁", "调素琴", "案牍之劳形"]
      },
      {
        "text": "南阳诸葛庐，西蜀子云亭。孔子云：何陋之有？",
        "pinyin": [
          { "w": "诸葛庐", "p": "zhū gě lú" },
          { "w": "西蜀", "p": "xī shǔ" },
          { "w": "何陋之有", "p": "hé lòu zhī yǒu" }
        ],
        "keys": ["南阳诸葛庐", "西蜀子云亭", "何陋之有"]
      }
    ]
  },
  {
    "id": "ailianshuo",
    "title": "爱莲说",
    "author": "周敦颐",
    "dynasty": "宋",
    "type": "wenyan",
    "term": "七下",
    "level": "中考必背",
    "no": 57,
    "unit": "七下 课标必背",
    "paras": [
      {
        "text": "水陆草木之花，可爱者甚蕃。晋陶渊明独爱菊。自李唐来，世人甚爱牡丹。",
        "pinyin": [
          { "w": "甚蕃", "p": "shèn fán" },
          { "w": "陶渊明", "p": "táo yuān míng" },
          { "w": "李唐", "p": "lǐ táng" }
        ],
        "keys": ["水陆草木之花", "可爱者甚蕃", "独爱菊", "世人甚爱牡丹"]
      },
      {
        "text": "予独爱莲之出淤泥而不染，濯清涟而不妖，中通外直，不蔓不枝，香远益清，亭亭净植，可远观而不可亵玩焉。",
        "pinyin": [
          { "w": "淤泥", "p": "yū ní" },
          { "w": "濯清涟", "p": "zhuó qīng lián" },
          { "w": "不蔓不枝", "p": "bù màn bù zhī" },
          { "w": "亭亭净植", "p": "tíng tíng jìng zhí" },
          { "w": "亵玩", "p": "xiè wán" }
        ],
        "keys": ["出淤泥而不染", "濯清涟而不妖", "中通外直", "不蔓不枝", "香远益清", "亵玩焉"]
      },
      {
        "text": "予谓菊，花之隐逸者也；牡丹，花之富贵者也；莲，花之君子者也。噫！菊之爱，陶后鲜有闻。莲之爱，同予者何人？牡丹之爱，宜乎众矣。",
        "pinyin": [
          { "w": "隐逸", "p": "yǐn yì" },
          { "w": "噫", "p": "yī" },
          { "w": "鲜有闻", "p": "xiǎn yǒu wén" },
          { "w": "宜乎众矣", "p": "yí hū zhòng yǐ" }
        ],
        "keys": ["花之隐逸者也", "花之富贵者也", "花之君子者也", "陶后鲜有闻", "同予者何人", "宜乎众矣"]
      }
    ]
  },
  {
    "id": "yinjiu",
    "title": "饮酒（其五）",
    "author": "陶渊明",
    "dynasty": "东晋",
    "type": "poem",
    "term": "八上",
    "level": "中考必背",
    "no": 5,
    "unit": "八上 课标必背",
    "paras": [
      {
        "text": "结庐在人境，而无车马喧。问君何能尔？心远地自偏。",
        "pinyin": [
          { "w": "结庐", "p": "jié lú" },
          { "w": "车马喧", "p": "chē mǎ xuān" },
          { "w": "何能尔", "p": "hé néng ěr" }
        ],
        "keys": ["结庐在人境", "车马喧", "何能尔", "心远地自偏"]
      },
      {
        "text": "采菊东篱下，悠然见南山。山气日夕佳，飞鸟相与还。",
        "pinyin": [
          { "w": "东篱", "p": "dōng lí" },
          { "w": "悠然", "p": "yōu rán" },
          { "w": "相与还", "p": "xiāng yǔ huán" }
        ],
        "keys": ["采菊东篱下", "悠然见南山", "山气日夕佳", "飞鸟相与还"]
      },
      {
        "text": "此中有真意，欲辨已忘言。",
        "pinyin": [
          { "w": "真意", "p": "zhēn yì" },
          { "w": "欲辨", "p": "yù biàn" },
          { "w": "忘言", "p": "wàng yán" }
        ],
        "keys": ["此中有真意", "欲辨已忘言"]
      }
    ]
  },
  {
    "id": "shizhisaishang",
    "title": "使至塞上",
