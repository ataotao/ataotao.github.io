        "keys": ["黑云压城", "城欲摧", "甲光向日", "金鳞开", "燕脂凝夜紫"]
      },
      {
        "text": "半卷红旗临易水，霜重鼓寒声不起。报君黄金台上意，提携玉龙为君死。",
        "pinyin": [
          { "w": "半卷", "p": "bàn juǎn" },
          { "w": "霜重", "p": "shuāng zhòng" },
          { "w": "提携", "p": "tí xié" },
          { "w": "玉龙", "p": "yù lóng" }
        ],
        "keys": ["半卷红旗", "临易水", "霜重鼓寒", "黄金台上意", "提携玉龙"]
      }
    ]
  },
