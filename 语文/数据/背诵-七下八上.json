        "keys": ["大漠孤烟直", "长河落日圆", "萧关逢候骑", "都护在燕然"]
      }
    ]
  },
  {
    "id": "huanghelou",
    "title": "黄鹤楼",
    "author": "崔颢",
    "dynasty": "唐",
    "type": "poem",
    "term": "八上",
    "level": "中考必背",
    "no": 13,
    "unit": "八上 课标必背",
    "paras": [
      {
        "text": "昔人已乘黄鹤去，此地空余黄鹤楼。黄鹤一去不复返，白云千载空悠悠。",
        "pinyin": [
          { "w": "昔人", "p": "xī rén" },
          { "w": "千载", "p": "qiān zǎi" },
          { "w": "悠悠", "p": "yōu yōu" }
        ],
        "keys": ["已乘黄鹤去", "空余黄鹤楼", "一去不复返", "白云千载"]
      },
      {
        "text": "晴川历历汉阳树，芳草萋萋鹦鹉洲。日暮乡关何处是？烟波江上使人愁。",
        "pinyin": [
