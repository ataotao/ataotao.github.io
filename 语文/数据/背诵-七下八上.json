    "unit": "八上 课标必背",
    "paras": [
      {
        "text": "元丰六年十月十二日夜，解衣欲睡，月色入户，欣然起行。念无与为乐者，遂至承天寺寻张怀民。",
        "pinyin": [
          { "w": "元丰", "p": "yuán fēng" },
          { "w": "欣然", "p": "xīn rán" },
          { "w": "无与为乐", "p": "wú yǔ wéi lè" },
          { "w": "承天寺", "p": "chéng tiān sì" }
        ],
        "keys": ["元丰六年", "解衣欲睡", "月色入户", "欣然起行", "寻张怀民"]
      },
      {
        "text": "怀民亦未寝，相与步于中庭。庭下如积水空明，水中藻、荇交横，盖竹柏影也。",
        "pinyin": [
          { "w": "未寝", "p": "wèi qǐn" },
          { "w": "相与", "p": "xiāng yǔ" },
          { "w": "藻、荇", "p": "zǎo xìng" },
          { "w": "竹柏", "p": "zhú bǎi" }
        ],
        "keys": ["怀民亦未寝", "相与步于中庭", "积水空明", "藻、荇交横", "竹柏影也"]
      },
      {
        "text": "何夜无月？何处无竹柏？但少闲人如吾两人者耳。",
        "pinyin": [
          { "w": "闲人", "p": "xián rén" },
          { "w": "吾两人", "p": "wú liǎng rén" }
        ],
        "keys": ["何夜无月", "何处无竹柏", "但少闲人", "吾两人者耳"]
      }
    ]
  }
