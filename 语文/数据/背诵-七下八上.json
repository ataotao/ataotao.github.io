    "unit": "八上 课标必背",
    "paras": [
      {
        "text": "山川之美，古来共谈。高峰入云，清流见底。两岸石壁，五色交辉。青林翠竹，四时俱备。",
        "pinyin": [
          { "w": "共谈", "p": "gòng tán" },
          { "w": "交辉", "p": "jiāo huī" },
          { "w": "四时俱备", "p": "sì shí jù bèi" }
        ],
        "keys": ["山川之美", "古来共谈", "高峰入云", "清流见底", "五色交辉", "四时俱备"]
      },
      {
        "text": "晓雾将歇，猿鸟乱鸣；夕日欲颓，沉鳞竞跃。",
        "pinyin": [
          { "w": "将歇", "p": "jiāng xiē" },
          { "w": "夕日欲颓", "p": "xī rì yù tuí" },
          { "w": "沉鳞", "p": "chén lín" },
          { "w": "竞跃", "p": "jìng yuè" }
        ],
        "keys": ["晓雾将歇", "猿鸟乱鸣", "夕日欲颓", "沉鳞竞跃"]
      },
      {
        "text": "实是欲界之仙都。自康乐以来，未复有能与其奇者。",
        "pinyin": [
          { "w": "欲界", "p": "yù jiè" },
          { "w": "康乐", "p": "kāng lè" },
          { "w": "与其奇者", "p": "yù qí qí zhě" }
        ],
        "keys": ["欲界之仙都", "康乐以来", "未复有", "与其奇者"]
      }
    ]
  },
  {
    "id": "sanxia",
    "title": "三峡",
    "author": "郦道元",
    "dynasty": "南北朝",
    "type": "wenyan",
    "term": "八上",
    "level": "中考必背",
    "no": 51,
    "unit": "八上 课标必背",
    "paras": [
      {
        "text": "自三峡七百里中，两岸连山，略无阙处。重岩叠嶂，隐天蔽日，自非亭午夜分，不见曦月。",
        "pinyin": [
          { "w": "略无阙处", "p": "lüè wú quē chù" },
          { "w": "重岩叠嶂", "p": "chóng yán dié zhàng" },
          { "w": "亭午", "p": "tíng wǔ" },
          { "w": "曦月", "p": "xī yuè" }
        ],
        "keys": ["两岸连山", "略无阙处", "重岩叠嶂", "隐天蔽日", "不见曦月"]
      },
      {
        "text": "至于夏水襄陵，沿溯阻绝。或王命急宣，有时朝发白帝，暮到江陵，其间千二百里，虽乘奔御风，不以疾也。",
        "pinyin": [
          { "w": "襄陵", "p": "xiāng líng" },
          { "w": "沿溯", "p": "yán sù" },
          { "w": "阻绝", "p": "zǔ jué" },
          { "w": "御风", "p": "yù fēng" }
        ],
        "keys": ["夏水襄陵", "沿溯阻绝", "王命急宣", "朝发白帝", "乘奔御风", "不以疾也"]
      },
      {
        "text": "春冬之时，则素湍绿潭，回清倒影，绝巘多生怪柏，悬泉瀑布，飞漱其间，清荣峻茂，良多趣味。",
        "pinyin": [
          { "w": "素湍", "p": "sù tuān" },
          { "w": "回清倒影", "p": "huí qīng dào yǐng" },
          { "w": "绝巘", "p": "jué yǎn" },
          { "w": "飞漱", "p": "fēi shù" },
          { "w": "清荣峻茂", "p": "qīng róng jùn mào" }
        ],
        "keys": ["素湍绿潭", "回清倒影", "绝巘", "悬泉瀑布", "飞漱其间", "清荣峻茂"]
      },
      {
        "text": "每至晴初霜旦，林寒涧肃，常有高猿长啸，属引凄异，空谷传响，哀转久绝。故渔者歌曰：“巴东三峡巫峡长，猿鸣三声泪沾裳。”",
        "pinyin": [
          { "w": "霜旦", "p": "shuāng dàn" },
          { "w": "涧肃", "p": "jiàn sù" },
          { "w": "属引", "p": "zhǔ yǐn" },
          { "w": "凄异", "p": "qī yì" },
          { "w": "泪沾裳", "p": "lèi zhān cháng" }
        ],
        "keys": ["晴初霜旦", "林寒涧肃", "高猿长啸", "属引凄异", "空谷传响", "哀转久绝"]
      }
    ]
  },
  {
    "id": "jichengsiyeyou",
