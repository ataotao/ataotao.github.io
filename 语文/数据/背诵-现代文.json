[
  {
    "id": "woaizhetudi",
    "title": "我爱这土地",
    "author": "艾青",
    "dynasty": "现代",
    "type": "modern",
    "unit": "九上 第1单元",
    "level": "教材必背",
    "paras": [
      {
        "text": "假如我是一只鸟，／我也应该用嘶哑的喉咙歌唱：／这被暴风雨所打击着的土地，／这永远汹涌着我们的悲愤的河流，／这无止息地吹刮着的激怒的风，／和那来自林间的无比温柔的黎明……／——然后我死了，／连羽毛也腐烂在土地里面。",
        "pinyin": [
          { "w": "嘶哑", "p": "sī yǎ" },
          { "w": "汹涌", "p": "xiōng yǒng" },
          { "w": "腐烂", "p": "fǔ làn" },
          { "w": "黎明", "p": "lí míng" }
        ],
        "keys": ["一只鸟", "暴风雨", "激怒的风", "温柔的黎明"]
      },
      {
        "text": "为什么我的眼里常含泪水？／因为我对这土地爱得深沉……",
        "pinyin": [
          { "w": "泪水", "p": "lèi shuǐ" },
          { "w": "深沉", "p": "shēn chén" }
        ],
        "keys": ["眼里常含泪水", "爱得深沉"]
      }
    ]
  },
  {
    "id": "xiangchou",
    "title": "乡愁",
    "author": "余光中",
    "dynasty": "现代",
    "type": "modern",
    "unit": "九上 第1单元",
    "level": "教材必背",
    "paras": [
      {
        "text": "小时候，／乡愁是一枚小小的邮票，／我在这头，／母亲在那头。",
        "pinyin": [
          { "w": "乡愁", "p": "xiāng chóu" },
          { "w": "邮票", "p": "yóu piào" }
        ],
        "keys": ["小小的邮票", "我在这头", "母亲在那头"]
      },
      {
        "text": "长大后，／乡愁是一张窄窄的船票，／我在这头，／新娘在那头。",
        "pinyin": [
          { "w": "窄窄", "p": "zhǎi zhǎi" },
          { "w": "船票", "p": "chuán piào" }
        ],
        "keys": ["窄窄的船票", "我在这头", "新娘在那头"]
      },
      {
        "text": "后来啊，／乡愁是一方矮矮的坟墓，／我在外头，／母亲在里头。",
        "pinyin": [
          { "w": "矮矮", "p": "ǎi ǎi" },
          { "w": "坟墓", "p": "fén mù" }
        ],
        "keys": ["矮矮的坟墓", "我在外头", "母亲在里头"]
      },
      {
        "text": "而现在，／乡愁是一湾浅浅的海峡，／我在这头，／大陆在那头。",
        "pinyin": [
          { "w": "浅浅", "p": "qiǎn qiǎn" },
          { "w": "海峡", "p": "hǎi xiá" }
        ],
        "keys": ["浅浅的海峡", "我在这头", "大陆在那头"]
      }
    ]
  },
  {
    "id": "nishirenjiandesiyuetian",
    "title": "你是人间的四月天",
    "author": "林徽因",
    "dynasty": "现代",
    "type": "modern",
    "unit": "九上 第1单元",
    "level": "教材必背",
    "paras": [
      {
        "text": "我说你是人间的四月天；／笑响点亮了四面风；轻灵／在春的光艳中交舞着变。",
        "pinyin": [
          { "w": "轻灵", "p": "qīng líng" },
          { "w": "光艳", "p": "guāng yàn" }
        ],
        "keys": ["人间的四月天", "四面风", "交舞着变"]
      },
      {
        "text": "你是四月早天里的云烟，／黄昏吹着风的软，星子在／无意中闪，细雨点洒在花前。",
        "pinyin": [
          { "w": "云烟", "p": "yún yān" },
          { "w": "黄昏", "p": "huáng hūn" }
        ],
        "keys": ["早天里的云烟", "黄昏", "细雨点洒"]
      },
      {
        "text": "那轻，那娉婷，你是，鲜妍／百花的冠冕你戴着，你是／天真，庄严，你是夜夜的月圆。",
        "pinyin": [
          { "w": "娉婷", "p": "pīng tíng" },
          { "w": "鲜妍", "p": "xiān yán" },
          { "w": "冠冕", "p": "guān miǎn" }
        ],
        "keys": ["天真", "庄严", "夜夜的月圆", "百花的冠冕"]
      },
      {
        "text": "雪化后那片鹅黄，你像；新鲜／初放芽的绿，你是；柔嫩喜悦／水光浮动着你梦期待中白莲。",
        "pinyin": [
          { "w": "鹅黄", "p": "é huáng" },
          { "w": "柔嫩", "p": "róu nèn" }
        ],
        "keys": ["雪化后", "初放芽的绿", "柔嫩喜悦", "水光浮动"]
      },
      {
        "text": "你是一树一树的花开，是燕／在梁间呢喃，——你是爱，是暖，／是希望，你是人间的四月天！",
        "pinyin": [
          { "w": "梁间", "p": "liáng jiān" },
          { "w": "呢喃", "p": "ní nán" }
        ],
        "keys": ["一树一树", "梁间呢喃", "是希望", "四月天"]
      }
    ]
  },
  {
    "id": "wokan",
    "title": "我看",
    "author": "穆旦",
    "dynasty": "现代",
    "type": "modern",
    "unit": "九上 第1单元",
    "level": "教材必背",
    "paras": [
      {
        "text": "我看一阵向晚的春风／悄悄揉过丰润的青草，／我看它们低首又低首，／也许远水荡起了一片绿潮；",
        "pinyin": [
          { "w": "丰润", "p": "fēng rùn" },
          { "w": "绿潮", "p": "lǜ cháo" }
        ],
        "keys": ["向晚的春风", "丰润的青草", "低首又低首", "一片绿潮"]
      },
      {
        "text": "我看飞鸟平展着翅翼／静静吸入深远的晴空里，／我看流云慢慢地红晕／无意沉醉了凝望它的大地。",
        "pinyin": [
          { "w": "翅翼", "p": "chì yì" },
          { "w": "红晕", "p": "hóng yùn" },
          { "w": "凝望", "p": "níng wàng" }
        ],
        "keys": ["平展着翅翼", "深远的晴空", "慢慢地红晕", "凝望它的大地"]
      },
      {
        "text": "哦，逝去的多少欢乐和忧戚，／我枉然在你的心胸里描画！／哦！多少年来你丰润的生命／永在寂静的谐奏里勃发。",
        "pinyin": [
          { "w": "忧戚", "p": "yōu qī" },
          { "w": "枉然", "p": "wǎng rán" },
          { "w": "谐奏", "p": "xié zòu" },
          { "w": "勃发", "p": "bó fā" }
        ],
        "keys": ["欢乐和忧戚", "心胸里描画", "寂静的谐奏", "丰润的生命"]
      },
      {
        "text": "也许远古的哲人怀着热望，／曾向你舒出咏赞的叹息，／如今却只见他生命的静流／随着季节的起伏而飘逸。",
        "pinyin": [
          { "w": "哲人", "p": "zhé rén" },
          { "w": "咏赞", "p": "yǒng zàn" },
          { "w": "飘逸", "p": "piāo yì" }
        ],
        "keys": ["远古的哲人", "咏赞的叹息", "生命的静流", "起伏而飘逸"]
      },
      {
        "text": "去吧，去吧，哦生命的飞奔，／叫天风挽你坦荡地漫游，／像鸟的歌唱，云的流盼，树的摇曳；／哦，让我的呼吸与自然合流！／让欢笑和哀愁洒向我心里，／像季节燃起花朵又把它吹熄。",
        "pinyin": [
          { "w": "坦荡", "p": "tǎn dàng" },
          { "w": "流盼", "p": "liú pàn" },
          { "w": "摇曳", "p": "yáo yè" }
        ],
        "keys": ["坦荡地漫游", "云的流盼", "树的摇曳", "与自然合流", "把它吹熄"]
      }
    ]
  },
  {
    "id": "baiyanglizan5",
    "title": "白杨礼赞·第5段",
    "author": "茅盾",
    "dynasty": "现代",
    "type": "modern",
    "unit": "九上 第2单元",
    "level": "了解",
    "paras": [
      {
        "text": "那是力争上游的一种树，笔直的干，笔直的枝。它的干通常是丈把高，像加过人工似的，一丈以内绝无旁枝。",
        "pinyin": [
          { "w": "丈把高", "p": "zhàng bǎ gāo" },
          { "w": "旁枝", "p": "páng zhī" }
        ],
        "keys": ["力争上游", "笔直的干", "笔直的枝", "绝无旁枝"]
      },
      {
        "text": "它所有的丫枝一律向上，而且紧紧靠拢，也像加过人工似的，成为一束，绝不旁逸斜出；它的宽大的叶子也是片片向上，几乎没有斜生的，更不用说倒垂了；它的皮光滑而有银色的晕圈，微微泛出淡青色。",
        "pinyin": [
          { "w": "丫枝", "p": "yā zhī" },
          { "w": "靠拢", "p": "kào lǒng" },
          { "w": "旁逸斜出", "p": "páng yì xié chū" },
          { "w": "晕圈", "p": "yùn quān" }
        ],
        "keys": ["一律向上", "紧紧靠拢", "绝不旁逸斜出", "片片向上", "淡青色"]
      },
      {
        "text": "这是虽在北方风雪的压迫下却保持着倔强挺立的一种树！哪怕只有碗那样粗细，它却努力向上发展，高到丈许，两丈，参天耸立，不折不挠，对抗着西北风。",
        "pinyin": [
          { "w": "倔强", "p": "jué jiàng" },
          { "w": "参天", "p": "cān tiān" },
          { "w": "不折不挠", "p": "bù zhé bù náo" }
        ],
        "keys": ["倔强挺立", "努力向上发展", "参天耸立", "不折不挠", "对抗着西北风"]
      }
    ]
  }
]
