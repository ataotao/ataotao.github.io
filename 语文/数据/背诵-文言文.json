[
  {
    "id": "chushibiao",
    "title": "出师表",
    "author": "诸葛亮",
    "dynasty": "三国·蜀汉",
    "type": "wenyan",
    "unit": "九上 第6单元",
    "paras": [
      {
        "text": "先帝创业未半而中道崩殂，今天下三分，益州疲弊，此诚危急存亡之秋也。然侍卫之臣不懈于内，忠志之士忘身于外者，盖追先帝之殊遇，欲报之于陛下也。诚宜开张圣听，以光先帝遗德，恢弘志士之气，不宜妄自菲薄，引喻失义，以塞忠谏之路也。",
        "pinyin": [
          { "w": "崩殂", "p": "bēng cú" },
          { "w": "疲弊", "p": "pí bì" },
          { "w": "恢弘", "p": "huī hóng" },
          { "w": "妄自菲薄", "p": "wàng zì fěi bó" },
          { "w": "引喻失义", "p": "yǐn yù shī yì" },
          { "w": "忠谏", "p": "zhōng jiàn" },
          { "w": "塞", "p": "sè" }
        ],
        "keys": ["崩殂", "疲弊", "危急存亡", "殊遇", "开张圣听", "妄自菲薄", "忠谏"]
      },
      {
        "text": "宫中府中，俱为一体，陟罚臧否，不宜异同。若有作奸犯科及为忠善者，宜付有司论其刑赏，以昭陛下平明之理，不宜偏私，使内外异法也。",
        "pinyin": [
          { "w": "陟罚臧否", "p": "zhì fá zāng pǐ" },
          { "w": "作奸犯科", "p": "zuò jiān fàn kē" },
          { "w": "有司", "p": "yǒu sī" },
          { "w": "刑赏", "p": "xíng shǎng" },
          { "w": "偏私", "p": "piān sī" },
          { "w": "异同", "p": "yì tóng" }
        ],
        "keys": ["陟罚臧否", "作奸犯科", "刑赏", "平明之理", "偏私", "内外异法"]
      },
      {
        "text": "侍中、侍郎郭攸之、费祎、董允等，此皆良实，志虑忠纯，是以先帝简拔以遗陛下。愚以为宫中之事，事无大小，悉以咨之，然后施行，必能裨补阙漏，有所广益。",
        "pinyin": [
          { "w": "费祎", "p": "fèi yī" },
          { "w": "简拔", "p": "jiǎn bá" },
          { "w": "遗陛下", "p": "wèi bì xià" },
          { "w": "裨补阙漏", "p": "bì bǔ quē lòu" },
          { "w": "良实", "p": "liáng shí" },
          { "w": "志虑忠纯", "p": "zhì lǜ zhōng chún" },
          { "w": "悉以咨之", "p": "xī yǐ zī zhī" }
        ],
        "keys": ["费祎", "良实", "简拔", "裨补阙漏", "有所广益", "悉以咨之"]
      },
      {
        "text": "将军向宠，性行淑均，晓畅军事，试用于昔日，先帝称之曰能，是以众议举宠为督。愚以为营中之事，悉以咨之，必能使行阵和睦，优劣得所。",
        "pinyin": [
          { "w": "向宠", "p": "xiàng chǒng" },
          { "w": "性行淑均", "p": "xìng xíng shū jūn" },
          { "w": "晓畅", "p": "xiǎo chàng" },
          { "w": "行阵", "p": "háng zhèn" },
          { "w": "优劣", "p": "yōu liè" },
          { "w": "为督", "p": "wéi dū" }
        ],
        "keys": ["向宠", "性行淑均", "晓畅军事", "行阵和睦", "优劣得所", "营中之事"]
      },
      {
        "text": "亲贤臣，远小人，此先汉所以兴隆也；亲小人，远贤臣，此后汉所以倾颓也。先帝在时，每与臣论此事，未尝不叹息痛恨于桓、灵也。侍中、尚书、长史、参军，此悉贞良死节之臣，愿陛下亲之信之，则汉室之隆，可计日而待也。",
        "pinyin": [
          { "w": "倾颓", "p": "qīng tuí" },
          { "w": "桓、灵", "p": "huán líng" },
          { "w": "长史", "p": "zhǎng shǐ" },
          { "w": "参军", "p": "cān jūn" },
          { "w": "贞良死节", "p": "zhēn liáng sǐ jié" },
          { "w": "痛恨", "p": "tòng hèn" }
        ],
        "keys": ["亲贤臣", "远小人", "兴隆", "倾颓", "贞良死节", "计日而待", "汉室之隆"]
      },
      {
        "text": "臣本布衣，躬耕于南阳，苟全性命于乱世，不求闻达于诸侯。先帝不以臣卑鄙，猥自枉屈，三顾臣于草庐之中，咨臣以当世之事，由是感激，遂许先帝以驱驰。后值倾覆，受任于败军之际，奉命于危难之间，尔来二十有一年矣。",
        "pinyin": [
          { "w": "躬耕", "p": "gōng gēng" },
          { "w": "卑鄙", "p": "bēi bǐ" },
          { "w": "猥自枉屈", "p": "wěi zì wǎng qū" },
          { "w": "草庐", "p": "cǎo lú" },
          { "w": "驱驰", "p": "qū chí" },
          { "w": "倾覆", "p": "qīng fù" },
          { "w": "尔来", "p": "ěr lái" }
        ],
        "keys": ["布衣", "躬耕", "卑鄙", "猥自枉屈", "草庐", "驱驰", "倾覆"]
      },
      {
        "text": "先帝知臣谨慎，故临崩寄臣以大事也。受命以来，夙夜忧叹，恐托付不效，以伤先帝之明，故五月渡泸，深入不毛。今南方已定，兵甲已足，当奖率三军，北定中原，庶竭驽钝，攘除奸凶，兴复汉室，还于旧都。此臣所以报先帝而忠陛下之职分也。至于斟酌损益，进尽忠言，则攸之、祎、允之任也。",
        "pinyin": [
          { "w": "夙夜", "p": "sù yè" },
          { "w": "渡泸", "p": "dù lú" },
          { "w": "不毛", "p": "bù máo" },
          { "w": "奖率", "p": "jiǎng shuài" },
          { "w": "驽钝", "p": "nú dùn" },
          { "w": "攘除", "p": "rǎng chú" },
          { "w": "斟酌损益", "p": "zhēn zhuó sǔn yì" },
          { "w": "职分", "p": "zhí fèn" }
        ],
        "keys": ["夙夜忧叹", "托付", "渡泸", "不毛", "兵甲", "北定中原", "攘除奸凶", "斟酌损益"]
      },
      {
        "text": "愿陛下托臣以讨贼兴复之效，不效，则治臣之罪，以告先帝之灵。若无兴德之言，则责攸之、祎、允等之慢，以彰其咎；陛下亦宜自谋，以咨诹善道，察纳雅言，深追先帝遗诏。臣不胜受恩感激。",
        "pinyin": [
          { "w": "讨贼", "p": "tǎo zéi" },
          { "w": "兴德", "p": "xīng dé" },
          { "w": "慢", "p": "màn" },
          { "w": "彰其咎", "p": "zhāng qí jiù" },
          { "w": "咨诹", "p": "zī zōu" },
          { "w": "察纳", "p": "chá nà" },
          { "w": "雅言", "p": "yǎ yán" },
          { "w": "遗诏", "p": "yí zhào" }
        ],
        "keys": ["讨贼兴复", "兴德之言", "彰其咎", "自谋", "咨诹善道", "察纳雅言", "遗诏"]
      },
      {
        "text": "今当远离，临表涕零，不知所言。",
        "pinyin": [
          { "w": "当", "p": "dāng" },
          { "w": "临表", "p": "lín biǎo" },
          { "w": "涕零", "p": "tì líng" }
        ],
        "keys": ["远离", "临表", "涕零", "不知所言"]
      }
    ]
  },
  {
    "id": "yueyanglouji",
    "title": "岳阳楼记",
    "author": "范仲淹",
    "dynasty": "北宋",
    "type": "wenyan",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "庆历四年春，滕子京谪守巴陵郡。越明年，政通人和，百废具兴，乃重修岳阳楼，增其旧制，刻唐贤今人诗赋于其上，属予作文以记之。",
        "pinyin": [
          { "w": "滕子京", "p": "téng zǐ jīng" },
          { "w": "谪守", "p": "zhé shǒu" },
          { "w": "巴陵", "p": "bā líng" },
          { "w": "百废具兴", "p": "bǎi fèi jù xīng" },
          { "w": "属予", "p": "zhǔ yǔ" },
          { "w": "诗赋", "p": "shī fù" }
        ],
        "keys": ["谪守", "巴陵郡", "政通人和", "百废具兴", "重修岳阳楼", "属予作文"]
      },
      {
        "text": "予观夫巴陵胜状，在洞庭一湖。衔远山，吞长江，浩浩汤汤，横无际涯，朝晖夕阴，气象万千，此则岳阳楼之大观也，前人之述备矣。然则北通巫峡，南极潇湘，迁客骚人，多会于此，览物之情，得无异乎？",
        "pinyin": [
          { "w": "予观夫", "p": "yú guān fú" },
          { "w": "浩浩汤汤", "p": "hào hào shāng shāng" },
          { "w": "横无际涯", "p": "héng wú jì yá" },
          { "w": "朝晖夕阴", "p": "zhāo huī xī yīn" },
          { "w": "巫峡", "p": "wū xiá" },
          { "w": "潇湘", "p": "xiāo xiāng" },
          { "w": "迁客骚人", "p": "qiān kè sāo rén" }
        ],
        "keys": ["胜状", "洞庭一湖", "衔远山", "浩浩汤汤", "朝晖夕阴", "气象万千", "迁客骚人", "览物之情"]
      },
      {
        "text": "若夫淫雨霏霏，连月不开，阴风怒号，浊浪排空，日星隐曜，山岳潜形，商旅不行，樯倾楫摧，薄暮冥冥，虎啸猿啼。登斯楼也，则有去国怀乡，忧谗畏讥，满目萧然，感极而悲者矣。",
        "pinyin": [
          { "w": "淫雨霏霏", "p": "yín yǔ fēi fēi" },
          { "w": "怒号", "p": "nù háo" },
          { "w": "浊浪", "p": "zhuó làng" },
          { "w": "隐曜", "p": "yǐn yào" },
          { "w": "潜形", "p": "qián xíng" },
          { "w": "樯倾楫摧", "p": "qiáng qīng jí cuī" },
          { "w": "薄暮", "p": "bó mù" },
          { "w": "冥冥", "p": "míng míng" },
          { "w": "忧谗畏讥", "p": "yōu chán wèi jī" }
        ],
        "keys": ["淫雨霏霏", "阴风怒号", "浊浪排空", "日星隐曜", "樯倾楫摧", "薄暮冥冥", "虎啸猿啼", "去国怀乡"]
      },
      {
        "text": "至若春和景明，波澜不惊，上下天光，一碧万顷，沙鸥翔集，锦鳞游泳，岸芷汀兰，郁郁青青。而或长烟一空，皓月千里，浮光跃金，静影沉璧，渔歌互答，此乐何极！登斯楼也，则有心旷神怡，宠辱偕忘，把酒临风，其喜洋洋者矣。",
        "pinyin": [
          { "w": "春和景明", "p": "chūn hé jǐng míng" },
          { "w": "波澜不惊", "p": "bō lán bù jīng" },
          { "w": "万顷", "p": "wàn qǐng" },
          { "w": "沙鸥翔集", "p": "shā ōu xiáng jí" },
          { "w": "锦鳞", "p": "jǐn lín" },
          { "w": "岸芷汀兰", "p": "àn zhǐ tīng lán" },
          { "w": "皓月", "p": "hào yuè" },
          { "w": "沉璧", "p": "chén bì" },
          { "w": "宠辱偕忘", "p": "chǒng rǔ xié wàng" }
        ],
        "keys": ["春和景明", "波澜不惊", "一碧万顷", "岸芷汀兰", "浮光跃金", "静影沉璧", "心旷神怡", "宠辱偕忘"]
      },
      {
        "text": "嗟夫！予尝求古仁人之心，或异二者之为，何哉？不以物喜，不以己悲，居庙堂之高则忧其民，处江湖之远则忧其君。是进亦忧，退亦忧。然则何时而乐耶？其必曰“先天下之忧而忧，后天下之乐而乐”乎！噫！微斯人，吾谁与归？时六年九月十五日。",
        "pinyin": [
          { "w": "嗟夫", "p": "jiē fú" },
          { "w": "古仁人", "p": "gǔ rén rén" },
          { "w": "庙堂", "p": "miào táng" },
          { "w": "乐耶", "p": "lè yé" },
          { "w": "噫", "p": "yī" },
          { "w": "微斯人", "p": "wēi sī rén" },
          { "w": "谁与归", "p": "shuí yǔ guī" }
        ],
        "keys": ["古仁人", "不以物喜", "不以己悲", "庙堂之高", "江湖之远", "吾谁与归"]
      }
    ]
  },
  {
    "id": "zuixiantingji",
    "title": "醉翁亭记",
    "author": "欧阳修",
    "dynasty": "北宋",
    "type": "wenyan",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "环滁皆山也。其西南诸峰，林壑尤美，望之蔚然而深秀者，琅琊也。山行六七里，渐闻水声潺潺，而泻出于两峰之间者，酿泉也。峰回路转，有亭翼然临于泉上者，醉翁亭也。作亭者谁？山之僧智仙也。名之者谁？太守自谓也。太守与客来饮于此，饮少辄醉，而年又最高，故自号曰醉翁也。醉翁之意不在酒，在乎山水之间也。山水之乐，得之心而寓之酒也。",
        "pinyin": [
          { "w": "环滁", "p": "huán chú" },
          { "w": "林壑", "p": "lín hè" },
          { "w": "蔚然", "p": "wèi rán" },
          { "w": "琅琊", "p": "láng yá" },
          { "w": "潺潺", "p": "chán chán" },
          { "w": "酿泉", "p": "niàng quán" },
          { "w": "辄", "p": "zhé" },
          { "w": "自号", "p": "zì hào" }
        ],
        "keys": ["环滁皆山", "林壑尤美", "琅琊", "酿泉", "峰回路转", "饮少辄醉", "醉翁之意", "山水之乐"]
      },
      {
        "text": "若夫日出而林霏开，云归而岩穴暝，晦明变化者，山间之朝暮也。野芳发而幽香，佳木秀而繁阴，风霜高洁，水落而石出者，山间之四时也。朝而往，暮而归，四时之景不同，而乐亦无穷也。",
        "pinyin": [
          { "w": "林霏", "p": "lín fēi" },
          { "w": "岩穴暝", "p": "yán xué míng" },
          { "w": "晦明", "p": "huì míng" },
          { "w": "朝暮", "p": "zhāo mù" },
          { "w": "野芳", "p": "yě fāng" },
          { "w": "繁阴", "p": "fán yīn" }
        ],
        "keys": ["林霏开", "岩穴暝", "晦明变化", "山间之朝暮", "佳木秀", "风霜高洁", "山间之四时", "乐亦无穷"]
      },
      {
        "text": "至于负者歌于途，行者休于树，前者呼，后者应，伛偻提携，往来而不绝者，滁人游也。临溪而渔，溪深而鱼肥，酿泉为酒，泉香而酒洌，山肴野蔌，杂然而前陈者，太守宴也。宴酣之乐，非丝非竹，射者中，弈者胜，觥筹交错，起坐而喧哗者，众宾欢也。苍颜白发，颓然乎其间者，太守醉也。",
        "pinyin": [
          { "w": "伛偻提携", "p": "yǔ lǚ tí xié" },
          { "w": "酒洌", "p": "jiǔ liè" },
          { "w": "山肴野蔌", "p": "shān yáo yě sù" },
          { "w": "杂然", "p": "zá rán" },
          { "w": "宴酣", "p": "yàn hān" },
          { "w": "射者中", "p": "shè zhě zhòng" },
          { "w": "弈者胜", "p": "yì zhě shèng" },
          { "w": "觥筹交错", "p": "gōng chóu jiāo cuò" },
          { "w": "颓然", "p": "tuí rán" }
        ],
        "keys": ["负者歌于途", "伛偻提携", "滁人游", "山肴野蔌", "太守宴", "宴酣之乐", "觥筹交错", "苍颜白发"]
      },
      {
        "text": "已而夕阳在山，人影散乱，太守归而宾客从也。树林阴翳，鸣声上下，游人去而禽鸟乐也。然而禽鸟知山林之乐，而不知人之乐；人知从太守游而乐，而不知太守之乐其乐也。醉能同其乐，醒能述以文者，太守也。太守谓谁？庐陵欧阳修也。",
        "pinyin": [
          { "w": "已而", "p": "yǐ ér" },
          { "w": "阴翳", "p": "yīn yì" },
          { "w": "禽鸟", "p": "qín niǎo" },
          { "w": "述以文", "p": "shù yǐ wén" },
          { "w": "庐陵", "p": "lú líng" }
        ],
        "keys": ["夕阳在山", "人影散乱", "树林阴翳", "禽鸟乐", "山林之乐", "太守归", "庐陵欧阳修", "醒能述以文"]
      }
    ]
  },
  {
    "id": "huxintingkanxue",
    "title": "湖心亭看雪",
    "author": "张岱",
    "dynasty": "明末清初",
    "type": "wenyan",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "崇祯五年十二月，余住西湖。大雪三日，湖中人鸟声俱绝。是日更定矣，余拏一小舟，拥毳衣炉火，独往湖心亭看雪。雾凇沆砀，天与云与山与水，上下一白。湖上影子，惟长堤一痕、湖心亭一点、与余舟一芥、舟中人两三粒而已。",
        "pinyin": [
          { "w": "崇祯", "p": "chóng zhēn" },
          { "w": "更定", "p": "gēng dìng" },
