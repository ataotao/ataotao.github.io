[
  {
    "id": "wuti",
    "title": "无题（相见时难别亦难）",
    "author": "李商隐",
    "dynasty": "唐",
    "type": "poem",
    "term": "九上",
    "level": "中考必背",
    "no": 25,
    "unit": "九上 课标必背",
    "paras": [
      {
        "text": "相见时难别亦难，东风无力百花残。",
        "pinyin": [
          {"w": "百花残", "p": "bǎi huā cán"}
        ],
        "keys": ["相见时难别亦难", "东风无力", "百花残"]
      },
      {
        "text": "春蚕到死丝方尽，蜡炬成灰泪始干。",
        "pinyin": [
          {"w": "蜡炬", "p": "là jù"},
          {"w": "泪始干", "p": "lèi shǐ gān"}
        ],
        "keys": ["春蚕到死", "丝方尽", "蜡炬成灰", "泪始干"]
      },
      {
        "text": "晓镜但愁云鬓改，夜吟应觉月光寒。",
        "pinyin": [
          {"w": "云鬓", "p": "yún bìn"},
          {"w": "夜吟", "p": "yè yín"}
        ],
        "keys": ["晓镜但愁", "云鬓改", "夜吟应觉", "月光寒"]
      },
      {
        "text": "蓬山此去无多路，青鸟殷勤为探看。",
        "pinyin": [
          {"w": "殷勤", "p": "yīn qín"},
          {"w": "探看", "p": "tàn kàn"}
        ],
        "keys": ["蓬山此去", "无多路", "青鸟殷勤", "为探看"]
      }
    ]
  }
]
