    "unit": "九下 课标必背",
    "paras": [
      {
        "text": "塞下秋来风景异，衡阳雁去无留意。四面边声连角起，千嶂里，长烟落日孤城闭。",
        "pinyin": [
          { "w": "塞下", "p": "sài xià" },
          { "w": "衡阳", "p": "héng yáng" },
          { "w": "边声", "p": "biān shēng" },
          { "w": "千嶂", "p": "qiān zhàng" },
          { "w": "长烟", "p": "cháng yān" }
        ],
        "keys": ["塞下秋来风景异", "衡阳雁去", "无留意", "千嶂里", "长烟落日孤城闭"]
      },
      {
        "text": "浊酒一杯家万里，燕然未勒归无计。羌管悠悠霜满地，人不寐，将军白发征夫泪。",
        "pinyin": [
          { "w": "浊酒", "p": "zhuó jiǔ" },
          { "w": "燕然", "p": "yān rán" },
          { "w": "勒", "p": "lè" },
          { "w": "羌管", "p": "qiāng guǎn" },
          { "w": "寐", "p": "mèi" }
        ],
        "keys": ["浊酒一杯", "家万里", "燕然未勒", "归无计", "羌管悠悠", "征夫泪"]
      }
    ]
  },
  {
    "id": "jiangchengzi",
    "title": "江城子（密州出猎）",
    "author": "苏轼",
    "dynasty": "宋",
    "type": "poem",
    "term": "九下",
    "level": "中考必背",
    "no": 30,
    "unit": "九下 课标必背",
    "paras": [
      {
        "text": "老夫聊发少年狂，左牵黄，右擎苍，锦帽貂裘，千骑卷平冈。为报倾城随太守，亲射虎，看孙郎。",
        "pinyin": [
          { "w": "聊发", "p": "liáo fā" },
          { "w": "擎苍", "p": "qíng cāng" },
          { "w": "锦帽貂裘", "p": "jǐn mào diāo qiú" },
          { "w": "千骑", "p": "qiān qí" },
          { "w": "卷平冈", "p": "juǎn píng gāng" },
          { "w": "倾城", "p": "qīng chéng" }
        ],
        "keys": ["老夫聊发少年狂", "左牵黄", "右擎苍", "锦帽貂裘", "千骑卷平冈", "看孙郎"]
      },
      {
        "text": "酒酣胸胆尚开张。鬓微霜，又何妨！持节云中，何日遣冯唐？会挽雕弓如满月，西北望，射天狼。",
        "pinyin": [
          { "w": "酒酣", "p": "jiǔ hān" },
          { "w": "胸胆", "p": "xiōng dǎn" },
          { "w": "鬓微霜", "p": "bìn wēi shuāng" },
          { "w": "遣冯唐", "p": "qiǎn féng táng" },
          { "w": "雕弓", "p": "diāo gōng" }
        ],
        "keys": ["酒酣胸胆尚开张", "鬓微霜", "又何妨", "持节云中", "遣冯唐", "射天狼"]
      }
    ]
  },
  {
    "id": "pozhenzi",
    "title": "破阵子（为陈同甫赋壮词以寄之）",
