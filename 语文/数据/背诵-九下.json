          { "w": "寂寞", "p": "jì mò" },
          { "w": "梧桐", "p": "wú tóng" },
          { "w": "锁清秋", "p": "suǒ qīng qiū" }
        ],
        "keys": ["无言独上西楼", "月如钩", "寂寞梧桐", "锁清秋"]
      },
      {
        "text": "剪不断，理还乱，是离愁。别是一般滋味在心头。",
        "pinyin": [
          { "w": "剪不断", "p": "jiǎn bù duàn" },
          { "w": "理还乱", "p": "lǐ huán luàn" },
          { "w": "离愁", "p": "lí chóu" },
          { "w": "滋味", "p": "zī wèi" }
        ],
        "keys": ["剪不断", "理还乱", "是离愁", "别是一般滋味", "在心头"]
      }
    ]
  },
  {
