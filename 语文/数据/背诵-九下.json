    "no": 35,
    "unit": "九下 课标必背",
    "paras": [
      {
        "text": "醉里挑灯看剑，梦回吹角连营。八百里分麾下炙，五十弦翻塞外声，沙场秋点兵。",
        "pinyin": [
          { "w": "挑灯", "p": "tiǎo dēng" },
          { "w": "吹角", "p": "chuī jiǎo" },
          { "w": "麾下", "p": "huī xià" },
          { "w": "炙", "p": "zhì" },
          { "w": "五十弦", "p": "wǔ shí xián" },
          { "w": "塞外", "p": "sài wài" }
        ],
        "keys": ["醉里挑灯看剑", "梦回吹角连营", "八百里", "麾下炙", "五十弦", "沙场秋点兵"]
      },
      {
        "text": "马作的卢飞快，弓如霹雳弦惊。了却君王天下事，赢得生前身后名。可怜白发生！",
        "pinyin": [
          { "w": "的卢", "p": "dì lú" },
          { "w": "霹雳", "p": "pī lì" },
          { "w": "弦惊", "p": "xián jīng" },
          { "w": "了却", "p": "liǎo què" },
          { "w": "赢得", "p": "yíng dé" }
        ],
        "keys": ["马作的卢飞快", "弓如霹雳弦惊", "了却君王天下事", "生前身后名", "可怜白发生"]
      }
    ]
  },
  {
    "id": "manjianghong",
    "title": "满江红（小住京华）",
    "author": "秋瑾",
    "dynasty": "清",
    "type": "poem",
    "term": "九下",
    "level": "中考必背",
    "no": 40,
    "unit": "九下 课标必背",
    "paras": [
      {
        "text": "小住京华，早又是中秋佳节。为篱下黄花开遍，秋容如拭。四面歌残终破楚，八年风味徒思浙。苦将侬强派作蛾眉，殊未屑！",
        "pinyin": [
          { "w": "京华", "p": "jīng huá" },
          { "w": "篱下", "p": "lí xià" },
          { "w": "秋容如拭", "p": "qiū róng rú shì" },
          { "w": "破楚", "p": "pò chǔ" },
          { "w": "徒思浙", "p": "tú sī zhè" },
          { "w": "强派", "p": "qiǎng pài" },
          { "w": "蛾眉", "p": "é méi" },
          { "w": "未屑", "p": "wèi xiè" }
        ],
        "keys": ["小住京华", "黄花开遍", "秋容如拭", "四面歌残终破楚", "八年风味徒思浙", "殊未屑"]
      },
      {
        "text": "身不得，男儿列，心却比，男儿烈。算平生肝胆，因人常热。俗子胸襟谁识我？英雄末路当磨折。莽红尘何处觅知音？青衫湿！",
        "pinyin": [
          { "w": "男儿列", "p": "nán ér liè" },
          { "w": "肝胆", "p": "gān dǎn" },
          { "w": "胸襟", "p": "xiōng jīn" },
          { "w": "末路", "p": "mò lù" },
          { "w": "磨折", "p": "mó zhé" },
          { "w": "莽红尘", "p": "mǎng hóng chén" },
          { "w": "知音", "p": "zhī yīn" },
          { "w": "青衫湿", "p": "qīng shān shī" }
        ],
        "keys": ["男儿列", "男儿烈", "算平生肝胆", "俗子胸襟", "莽红尘何处觅知音", "青衫湿"]
      }
    ]
  },
  {
    "id": "mengzi",
    "title": "《孟子》三则",
    "author": "《孟子》",
    "dynasty": "先秦",
    "type": "wenyan",
    "term": "九下",
    "level": "中考必背",
    "no": 43,
    "unit": "九下 课标必背",
    "paras": [
      {
        "text": "鱼，我所欲也；熊掌，亦我所欲也。二者不可得兼，舍鱼而取熊掌者也。生，亦我所欲也；义，亦我所欲也。二者不可得兼，舍生而取义者也。",
        "pinyin": [
          { "w": "熊掌", "p": "xióng zhǎng" },
          { "w": "得兼", "p": "dé jiān" },
          { "w": "舍鱼而取熊掌", "p": "shě yú ér qǔ xióng zhǎng" },
          { "w": "舍生而取义", "p": "shě shēng ér qǔ yì" }
        ],
        "keys": ["我所欲也", "熊掌", "二者不可得兼", "舍鱼而取熊掌", "舍生而取义者也"]
      },
      {
        "text": "天时不如地利，地利不如人和。三里之城，七里之郭，环而攻之而不胜。夫环而攻之，必有得天时者矣，然而不胜者，是天时不如地利也。城非不高也，池非不深也，兵革非不坚利也，米粟非不多也，委而去之，是地利不如人和也。",
        "pinyin": [
          { "w": "三里之城", "p": "sān lǐ zhī chéng" },
          { "w": "七里之郭", "p": "qī lǐ zhī guō" },
          { "w": "环而攻之", "p": "huán ér gōng zhī" },
          { "w": "兵革", "p": "bīng gé" },
          { "w": "米粟", "p": "mǐ sù" },
          { "w": "委而去之", "p": "wěi ér qù zhī" }
        ],
        "keys": ["天时不如地利", "地利不如人和", "三里之城", "七里之郭", "环而攻之", "委而去之"]
      },
      {
        "text": "故曰：域民不以封疆之界，固国不以山溪之险，威天下不以兵革之利。得道者多助，失道者寡助。寡助之至，亲戚畔之；多助之至，天下顺之。以天下之所顺，攻亲戚之所畔，故君子有不战，战必胜矣。",
        "pinyin": [
          { "w": "域民", "p": "yù mín" },
          { "w": "封疆", "p": "fēng jiāng" },
          { "w": "山溪", "p": "shān xī" },
          { "w": "寡助", "p": "guǎ zhù" },
          { "w": "亲戚畔之", "p": "qīn qī pàn zhī" },
          { "w": "天下顺之", "p": "tiān xià shùn zhī" }
        ],
        "keys": ["域民不以封疆之界", "固国不以山溪之险", "威天下不以兵革之利", "得道者多助", "失道者寡助", "战必胜矣"]
      },
      {
        "text": "舜发于畎亩之中，傅说举于版筑之间，胶鬲举于鱼盐之中，管夷吾举于士，孙叔敖举于海，百里奚举于市。故天将降大任于是人也，必先苦其心志，劳其筋骨，饿其体肤，空乏其身，行拂乱其所为，所以动心忍性，曾益其所不能。",
        "pinyin": [
          { "w": "畎亩", "p": "quǎn mǔ" },
          { "w": "傅说", "p": "fù yuè" },
          { "w": "胶鬲", "p": "jiāo gé" },
          { "w": "孙叔敖", "p": "sūn shū áo" },
          { "w": "百里奚", "p": "bǎi lǐ xī" },
          { "w": "空乏", "p": "kōng fá" },
          { "w": "拂乱", "p": "fú luàn" },
          { "w": "曾益", "p": "zēng yì" }
        ],
        "keys": ["畎亩之中", "版筑之间", "鱼盐之中", "孙叔敖举于海", "百里奚举于市", "曾益其所不能"]
      },
      {
        "text": "人恒过，然后能改；困于心，衡于虑，而后作；征于色，发于声，而后喻。入则无法家拂士，出则无敌国外患者，国恒亡。然后知生于忧患而死于安乐也。",
        "pinyin": [
          { "w": "恒过", "p": "héng guò" },
          { "w": "衡于虑", "p": "héng yú lǜ" },
          { "w": "而后作", "p": "ér hòu zuò" },
          { "w": "征于色", "p": "zhēng yú sè" },
          { "w": "拂士", "p": "bì shì" },
          { "w": "敌国外患者", "p": "dí guó wài huàn zhě" }
        ],
        "keys": ["人恒过", "衡于虑", "而后作", "发于声", "无法家拂士", "生于忧患而死于安乐"]
      }
    ]
  },
  {
    "id": "songdongyangmashengxu",
    "title": "送东阳马生序（节选）",
    "author": "宋濂",
    "dynasty": "明",
    "type": "wenyan",
    "term": "九下",
    "level": "中考必背",
    "no": 59,
    "unit": "九下 课标必背",
    "paras": [
      {
        "text": "余幼时即嗜学。家贫，无从致书以观，每假借于藏书之家，手自笔录，计日以还。天大寒，砚冰坚，手指不可屈伸，弗之怠。录毕，走送之，不敢稍逾约。以是人多以书假余，余因得遍观群书。",
        "pinyin": [
          { "w": "嗜学", "p": "shì xué" },
          { "w": "假借", "p": "jiǎ jiè" },
          { "w": "手自笔录", "p": "shǒu zì bǐ lù" },
          { "w": "砚冰坚", "p": "yàn bīng jiān" },
          { "w": "弗之怠", "p": "fú zhī dài" },
          { "w": "逾约", "p": "yú yuē" }
        ],
        "keys": ["余幼时即嗜学", "无从致书以观", "手自笔录", "计日以还", "不敢稍逾约", "遍观群书"]
      },
      {
        "text": "既加冠，益慕圣贤之道。又患无硕师名人与游，尝趋百里外，从乡之先达执经叩问。先达德隆望尊，门人弟子填其室，未尝稍降辞色。余立侍左右，援疑质理，俯身倾耳以请；或遇其叱咄，色愈恭，礼愈至，不敢出一言以复；俟其欣悦，则又请焉。故余虽愚，卒获有所闻。",
        "pinyin": [
          { "w": "加冠", "p": "jiā guàn" },
          { "w": "硕师", "p": "shuò shī" },
          { "w": "叩问", "p": "kòu wèn" },
          { "w": "德隆望尊", "p": "dé lóng wàng zūn" },
          { "w": "叱咄", "p": "chì duō" },
          { "w": "俟", "p": "sì" },
          { "w": "援疑质理", "p": "yuán yí zhì lǐ" }
        ],
        "keys": ["益慕圣贤之道", "硕师名人", "执经叩问", "德隆望尊", "援疑质理", "卒获有所闻"]
      },
      {
        "text": "当余之从师也，负箧曳屣行深山巨谷中。穷冬烈风，大雪深数尺，足肤皲裂而不知。至舍，四支僵劲不能动，媵人持汤沃灌，以衾拥覆，久而乃和。寓逆旅，主人日再食，无鲜肥滋味之享。同舍生皆被绮绣，戴朱缨宝饰之帽，腰白玉之环，左佩刀，右备容臭，烨然若神人；余则缊袍敝衣处其间，略无慕艳意，以中有足乐者，不知口体之奉不若人也。盖余之勤且艰若此。",
        "pinyin": [
          { "w": "负箧曳屣", "p": "fù qiè yè xǐ" },
          { "w": "皲裂", "p": "jūn liè" },
          { "w": "媵人", "p": "yìng rén" },
          { "w": "衾", "p": "qīn" },
          { "w": "被绮绣", "p": "pī qǐ xiù" },
          { "w": "容臭", "p": "róng xiù" },
          { "w": "烨然", "p": "yè rán" },
          { "w": "缊袍敝衣", "p": "yùn páo bì yī" }
        ],
        "keys": ["负箧曳屣", "穷冬烈风", "皲裂", "腰白玉之环", "缊袍敝衣", "口体之奉"]
      },
      {
        "text": "今虽耄老，未有所成，犹幸预君子之列，而承天子之宠光，缀公卿之后，日侍坐备顾问，四海亦谬称其氏名，况才之过于余者乎？",
        "pinyin": [
          { "w": "耄老", "p": "mào lǎo" },
          { "w": "预君子之列", "p": "yù jūn zǐ zhī liè" },
          { "w": "宠光", "p": "chǒng guāng" },
          { "w": "缀公卿", "p": "zhuì gōng qīng" },
          { "w": "谬称", "p": "miù chēng" }
        ],
        "keys": ["今虽耄老", "未有所成", "君子之列", "缀公卿之后", "谬称其氏名", "况才之过于余者乎"]
      }
    ]
  }
]
