  {
    "id": "lunyu",
    "title": "《论语》十二章",
    "author": "《论语》",
    "dynasty": "先秦",
    "type": "wenyan",
    "term": "七上",
    "level": "中考必背",
    "no": 41,
    "unit": "七上 课标必背",
    "paras": [
      {
        "text": "子曰：“学而时习之，不亦说乎？有朋自远方来，不亦乐乎？人不知而不愠，不亦君子乎？”",
        "pinyin": [
          { "w": "不亦说乎", "p": "bù yì yuè hū" },
          { "w": "愠", "p": "yùn" }
        ],
        "keys": ["学而时习之", "不亦说乎", "有朋自远方来", "人不知而不愠"]
      },
      {
        "text": "子曰：“吾日三省吾身：为人谋而不忠乎？与朋友交而不信乎？传不习乎？”",
        "pinyin": [
          { "w": "三省", "p": "sān xǐng" },
          { "w": "传", "p": "chuán" }
        ],
        "keys": ["吾日三省吾身", "为人谋而不忠", "与朋友交而不信", "传不习乎"]
      },
      {
        "text": "子曰：“吾十有五而志于学，三十而立，四十而不惑，五十而知天命，六十而耳顺，七十而从心所欲，不逾矩。”",
        "pinyin": [
          { "w": "十有五", "p": "shí yòu wǔ" },
          { "w": "逾矩", "p": "yú jǔ" }
        ],
        "keys": ["十有五而志于学", "三十而立", "四十而不惑", "五十而知天命", "不逾矩"]
      },
      {
        "text": "子曰：“温故而知新，可以为师矣。”",
        "pinyin": [
          { "w": "温故", "p": "wēn gù" },
          { "w": "矣", "p": "yǐ" }
        ],
        "keys": ["温故而知新", "可以为师矣"]
      },
      {
        "text": "子曰：“学而不思则罔，思而不学则殆。”",
        "pinyin": [
          { "w": "罔", "p": "wǎng" },
          { "w": "殆", "p": "dài" }
        ],
        "keys": ["学而不思则罔", "思而不学则殆"]
      },
      {
        "text": "子曰：“贤哉，回也！一箪食，一瓢饮，在陋巷，人不堪其忧，回也不改其乐。贤哉，回也！”",
        "pinyin": [
          { "w": "箪", "p": "dān" },
          { "w": "陋巷", "p": "lòu xiàng" },
          { "w": "堪", "p": "kān" }
        ],
        "keys": ["一箪食", "一瓢饮", "在陋巷", "人不堪其忧", "不改其乐"]
      },
      {
        "text": "子曰：“知之者不如好之者，好之者不如乐之者。”",
        "pinyin": [
          { "w": "好之者", "p": "hào zhī zhě" },
          { "w": "乐之者", "p": "lè zhī zhě" }
        ],
        "keys": ["知之者不如好之者", "好之者不如乐之者"]
      },
      {
        "text": "子曰：“饭疏食，饮水，曲肱而枕之，乐亦在其中矣。不义而富且贵，于我如浮云。”",
        "pinyin": [
          { "w": "饭疏食", "p": "fàn shū shí" },
          { "w": "曲肱", "p": "qū gōng" },
          { "w": "枕之", "p": "zhěn zhī" }
        ],
        "keys": ["饭疏食", "曲肱而枕之", "乐亦在其中", "不义而富且贵", "于我如浮云"]
      },
      {
        "text": "子曰：“三人行，必有我师焉。择其善者而从之，其不善者而改之。”",
        "pinyin": [
          { "w": "焉", "p": "yān" },
          { "w": "择", "p": "zé" }
        ],
        "keys": ["三人行", "必有我师焉", "择其善者而从之", "其不善者而改之"]
      },
      {
        "text": "子在川上曰：“逝者如斯夫，不舍昼夜。”",
        "pinyin": [
          { "w": "逝者如斯夫", "p": "shì zhě rú sī fú" },
          { "w": "不舍昼夜", "p": "bù shě zhòu yè" }
        ],
        "keys": ["逝者如斯夫", "不舍昼夜"]
      },
      {
        "text": "子曰：“三军可夺帅也，匹夫不可夺志也。”",
        "pinyin": [
          { "w": "夺帅", "p": "duó shuài" },
          { "w": "匹夫", "p": "pǐ fū" }
        ],
        "keys": ["三军可夺帅", "匹夫不可夺志"]
      },
      {
        "text": "子夏曰：“博学而笃志，切问而近思，仁在其中矣。”",
        "pinyin": [
          { "w": "笃志", "p": "dǔ zhì" },
          { "w": "切问", "p": "qiè wèn" }
        ],
        "keys": ["博学而笃志", "切问而近思", "仁在其中"]
      }
    ]
  },
  {
    "id": "boyagugu",
    "title": "《吕氏春秋》一则（伯牙鼓琴）",
    "author": "《吕氏春秋》",
    "dynasty": "先秦",
    "type": "wenyan",
    "term": "七上",
    "level": "中考必背",
    "no": 46,
    "unit": "七上 课标必背",
    "paras": [
      {
        "text": "伯牙鼓琴，锺子期听之。方鼓琴而志在太山，锺子期曰：“善哉乎鼓琴，巍巍乎若太山。”少选之间而志在流水，锺子期又曰：“善哉乎鼓琴，汤汤乎若流水。”",
        "pinyin": [
          { "w": "鼓琴", "p": "gǔ qín" },
          { "w": "善哉", "p": "shàn zāi" },
          { "w": "巍巍", "p": "wēi wēi" },
          { "w": "汤汤", "p": "shāng shāng" },
          { "w": "少选", "p": "shǎo xuǎn" }
        ],
        "keys": ["伯牙鼓琴", "志在太山", "巍巍乎若太山", "志在流水", "汤汤乎若流水"]
      },
      {
        "text": "锺子期死，伯牙破琴绝弦，终身不复鼓琴，以为世无足复为鼓琴者。",
        "pinyin": [
          { "w": "破琴绝弦", "p": "pò qín jué xián" },
          { "w": "复为鼓琴者", "p": "fù wéi gǔ qín zhě" }
        ],
        "keys": ["锺子期死", "破琴绝弦", "终身不复鼓琴", "世无足复为鼓琴者"]
      }
    ]
  }
]
