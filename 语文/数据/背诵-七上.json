[
  {
    "id": "guancanghai",
    "title": "观沧海",
    "author": "曹操",
    "dynasty": "东汉",
    "type": "poem",
    "term": "七上",
    "level": "中考必背",
    "no": 4,
    "unit": "七上 课标必背",
    "paras": [
      {
        "text": "东临碣石，以观沧海。水何澹澹，山岛竦峙。",
        "pinyin": [
          { "w": "碣石", "p": "jié shí" },
          { "w": "澹澹", "p": "dàn dàn" },
          { "w": "竦峙", "p": "sǒng zhì" }
        ],
        "keys": ["东临碣石", "观沧海", "水何澹澹", "山岛竦峙"]
      },
      {
        "text": "树木丛生，百草丰茂。秋风萧瑟，洪波涌起。",
        "pinyin": [
          { "w": "萧瑟", "p": "xiāo sè" },
          { "w": "洪波", "p": "hóng bō" }
        ],
        "keys": ["树木丛生", "百草丰茂", "秋风萧瑟", "洪波涌起"]
      },
      {
        "text": "日月之行，若出其中；星汉灿烂，若出其里。",
        "pinyin": [
          { "w": "星汉", "p": "xīng hàn" },
          { "w": "灿烂", "p": "càn làn" }
        ],
        "keys": ["日月之行", "若出其中", "星汉灿烂", "若出其里"]
      },
      {
        "text": "幸甚至哉，歌以咏志。",
        "pinyin": [
          { "w": "哉", "p": "zāi" },
          { "w": "咏志", "p": "yǒng zhì" }
        ],
        "keys": ["幸甚至哉", "歌以咏志"]
      }
    ]
  },
  {
    "id": "cibeishanxia",
    "title": "次北固山下",
    "author": "王湾",
    "dynasty": "唐",
    "type": "poem",
    "term": "七上",
    "level": "中考必背",
    "no": 9,
    "unit": "七上 课标必背",
    "paras": [
      {
        "text": "客路青山外，行舟绿水前。潮平两岸阔，风正一帆悬。",
        "pinyin": [
          { "w": "一帆悬", "p": "yī fán xuán" },
          { "w": "潮平", "p": "cháo píng" }
        ],
        "keys": ["客路青山外", "行舟绿水前", "潮平两岸阔", "风正一帆悬"]
      },
      {
        "text": "海日生残夜，江春入旧年。乡书何处达？归雁洛阳边。",
        "pinyin": [
          { "w": "残夜", "p": "cán yè" },
          { "w": "归雁", "p": "guī yàn" }
        ],
        "keys": ["海日生残夜", "江春入旧年", "乡书何处达", "归雁洛阳边"]
      }
    ]
  },
  {
    "id": "wenwangchangling",
    "title": "闻王昌龄左迁龙标遥有此寄",
    "author": "李白",
    "dynasty": "唐",
    "type": "poem",
    "term": "七上",
    "level": "中考必背",
    "no": 11,
    "unit": "七上 课标必背",
    "paras": [
      {
        "text": "杨花落尽子规啼，闻道龙标过五溪。",
        "pinyin": [
          { "w": "子规", "p": "zǐ guī" },
          { "w": "五溪", "p": "wǔ xī" }
        ],
        "keys": ["杨花落尽", "子规啼", "闻道龙标", "过五溪"]
      },
      {
        "text": "我寄愁心与明月，随君直到夜郎西。",
        "pinyin": [
          { "w": "愁心", "p": "chóu xīn" },
          { "w": "夜郎", "p": "yè láng" }
        ],
        "keys": ["我寄愁心", "与明月", "随君直到", "夜郎西"]
      }
    ]
  },
  {
    "id": "yeyujibei",
    "title": "夜雨寄北",
