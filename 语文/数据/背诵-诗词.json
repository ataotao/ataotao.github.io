[
  {
    "id": "qinyuanchunsnow",
    "title": "沁园春·雪",
    "author": "毛泽东",
    "dynasty": "现代",
    "type": "poem",
    "unit": "九上 第1单元",
    "paras": [
      {
        "text": "北国风光，千里冰封，万里雪飘。望长城内外，惟余莽莽；大河上下，顿失滔滔。",
        "pinyin": [
          {
            "w": "惟余莽莽",
            "p": "wéi yú mǎng mǎng"
          },
          {
            "w": "滔滔",
            "p": "tāo tāo"
          }
        ],
        "keys": [
          "北国风光",
          "千里冰封",
          "万里雪飘",
          "惟余莽莽"
        ]
      },
      {
        "text": "山舞银蛇，原驰蜡象，欲与天公试比高。须晴日，看红装素裹，分外妖娆。",
        "pinyin": [
          {
            "w": "原驰蜡象",
            "p": "yuán chí là xiàng"
          },
          {
            "w": "红装素裹",
            "p": "hóng zhuāng sù guǒ"
          },
          {
            "w": "妖娆",
            "p": "yāo ráo"
          }
        ],
        "keys": [
          "山舞银蛇",
          "原驰蜡象",
          "红装素裹",
          "妖娆"
        ]
      },
      {
        "text": "江山如此多娇，引无数英雄竞折腰。惜秦皇汉武，略输文采；唐宗宋祖，稍逊风骚。",
        "pinyin": [
          {
            "w": "竞折腰",
            "p": "jìng zhé yāo"
          },
          {
            "w": "稍逊风骚",
            "p": "shāo xùn fēng sāo"
          }
        ],
        "keys": [
          "江山如此多娇",
          "竞折腰",
          "秦皇汉武",
          "稍逊风骚"
        ]
      },
      {
        "text": "一代天骄，成吉思汗，只识弯弓射大雕。俱往矣，数风流人物，还看今朝。",
        "pinyin": [
          {
            "w": "成吉思汗",
            "p": "chéng jí sī hán"
          },
          {
            "w": "弯弓",
            "p": "wān gōng"
          },
          {
            "w": "俱往矣",
            "p": "jù wǎng yǐ"
          }
        ],
        "keys": [
          "一代天骄",
          "成吉思汗",
          "弯弓",
          "风流人物",
          "今朝"
        ]
      }
    ]
  },
  {
    "id": "xinglunan",
    "title": "行路难（其一）",
    "author": "李白",
    "dynasty": "唐",
    "type": "poem",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "金樽清酒斗十千，玉盘珍羞直万钱。停杯投箸不能食，拔剑四顾心茫然。",
        "pinyin": [
          {
            "w": "金樽",
            "p": "jīn zūn"
          },
          {
            "w": "珍羞",
            "p": "zhēn xiū"
          },
          {
            "w": "投箸",
            "p": "tóu zhù"
          }
        ],
        "keys": [
          "金樽清酒",
          "珍羞",
          "投箸",
          "心茫然"
        ]
      },
      {
        "text": "欲渡黄河冰塞川，将登太行雪满山。闲来垂钓碧溪上，忽复乘舟梦日边。",
        "pinyin": [
          {
            "w": "冰塞川",
            "p": "bīng sè chuān"
          },
          {
            "w": "太行",
            "p": "tài háng"
          },
          {
            "w": "垂钓",
            "p": "chuí diào"
          }
        ],
        "keys": [
          "冰塞川",
          "太行",
          "垂钓碧溪",
          "梦日边"
        ]
      },
      {
        "text": "行路难，行路难，多歧路，今安在？长风破浪会有时，直挂云帆济沧海。",
        "pinyin": [
          {
            "w": "歧路",
            "p": "qí lù"
          },
          {
            "w": "云帆",
            "p": "yún fān"
          },
          {
            "w": "沧海",
            "p": "cāng hǎi"
          }
        ],
        "keys": [
          "行路难",
          "多歧路",
          "长风破浪",
          "云帆",
          "济沧海"
        ]
      }
    ]
  },
  {
    "id": "choulefuleshang",
    "title": "酬乐天扬州初逢席上见赠",
    "author": "刘禹锡",
    "dynasty": "唐",
    "type": "poem",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "巴山楚水凄凉地，二十三年弃置身。怀旧空吟闻笛赋，到乡翻似烂柯人。",
        "pinyin": [
          {
            "w": "弃置身",
            "p": "qì zhì shēn"
          },
          {
            "w": "闻笛赋",
            "p": "wén dí fù"
          },
          {
            "w": "烂柯人",
            "p": "làn kē rén"
          }
        ],
        "keys": [
          "巴山楚水",
          "凄凉地",
          "二十三年",
          "闻笛赋",
          "烂柯人"
        ]
      },
      {
        "text": "沉舟侧畔千帆过，病树前头万木春。今日听君歌一曲，暂凭杯酒长精神。",
        "pinyin": [
          {
            "w": "侧畔",
            "p": "cè pàn"
          },
          {
            "w": "长精神",
            "p": "zhǎng jīng shén"
          }
        ],
        "keys": [
          "沉舟侧畔",
          "千帆过",
          "病树前头",
          "万木春",
          "长精神"
        ]
      }
    ]
  },
  {
    "id": "shuiligetou",
    "title": "水调歌头（明月几时有）",
    "author": "苏轼",
    "dynasty": "宋",
    "type": "poem",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "明月几时有？把酒问青天。不知天上宫阙，今夕是何年。我欲乘风归去，又恐琼楼玉宇，高处不胜寒。",
        "pinyin": [
          {
            "w": "宫阙",
            "p": "gōng què"
          },
          {
            "w": "琼楼玉宇",
            "p": "qióng lóu yù yǔ"
          },
          {
            "w": "不胜寒",
            "p": "bù shèng hán"
          }
        ],
        "keys": [
          "明月几时有",
          "宫阙",
          "琼楼玉宇",
          "高处不胜寒"
        ]
      },
      {
        "text": "起舞弄清影，何似在人间。转朱阁，低绮户，照无眠。不应有恨，何事长向别时圆？",
        "pinyin": [
          {
            "w": "绮户",
            "p": "qǐ hù"
          },
          {
            "w": "何事",
            "p": "hé shì"
          }
        ],
        "keys": [
          "弄清影",
          "何似在人间",
          "绮户",
          "照无眠",
          "别时圆"
        ]
      },
      {
        "text": "人有悲欢离合，月有阴晴圆缺，此事古难全。但愿人长久，千里共婵娟。",
        "pinyin": [
          {
            "w": "阴晴圆缺",
            "p": "yīn qíng yuán quē"
          },
          {
            "w": "婵娟",
            "p": "chán juān"
          }
        ],
        "keys": [
          "悲欢离合",
          "阴晴圆缺",
          "此事古难全",
          "人长久",
          "婵娟"
        ]
      }
    ]
  },
  {
    "id": "yeyueyisheidi",
    "title": "月夜忆舍弟",
    "author": "杜甫",
    "dynasty": "唐",
    "type": "poem",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "戍鼓断人行，边秋一雁声。露从今夜白，月是故乡明。",
        "pinyin": [
          {
            "w": "戍鼓",
            "p": "shù gǔ"
          },
          {
            "w": "一雁声",
            "p": "yī yàn shēng"
          }
        ],
        "keys": [
          "戍鼓",
          "断人行",
          "边秋",
          "露从今夜白",
          "月是故乡明"
        ]
      },
      {
        "text": "有弟皆分散，无家问死生。寄书长不达，况乃未休兵。",
        "pinyin": [
          {
            "w": "寄书",
            "p": "jì shū"
          },
          {
            "w": "况乃",
            "p": "kuàng nǎi"
          },
          {
            "w": "休兵",
            "p": "xiū bīng"
          }
        ],
        "keys": [
          "有弟皆分散",
          "无家问死生",
          "寄书",
          "长不达",
          "未休兵"
        ]
      }
    ]
  },
  {
    "id": "changshagouyizhai",
    "title": "长沙过贾谊宅",
    "author": "刘长卿",
    "dynasty": "唐",
    "type": "poem",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "三年谪宦此栖迟，万古惟留楚客悲。秋草独寻人去后，寒林空见日斜时。",
        "pinyin": [
          {
            "w": "谪宦",
            "p": "zhé huàn"
          },
          {
            "w": "栖迟",
            "p": "qī chí"
          },
          {
            "w": "楚客",
            "p": "chǔ kè"
          }
        ],
        "keys": [
          "三年谪宦",
          "栖迟",
          "楚客悲",
          "秋草",
          "日斜时"
        ]
      },
      {
        "text": "汉文有道恩犹薄，湘水无情吊岂知？寂寂江山摇落处，怜君何事到天涯！",
        "pinyin": [
          {
            "w": "恩犹薄",
            "p": "ēn yóu bó"
          },
          {
            "w": "吊岂知",
            "p": "diào qǐ zhī"
          },
          {
            "w": "摇落",
            "p": "yáo luò"
          }
        ],
        "keys": [
          "汉文有道",
          "恩犹薄",
          "湘水无情",
          "寂寂江山",
          "到天涯"
        ]
      }
    ]
  },
  {
    "id": "zuoqiandengguan",
    "title": "左迁至蓝关示侄孙湘",
    "author": "韩愈",
    "dynasty": "唐",
    "type": "poem",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "一封朝奏九重天，夕贬潮州路八千。欲为圣明除弊事，肯将衰朽惜残年！",
        "pinyin": [
          {
            "w": "朝奏",
            "p": "zhāo zòu"
          },
          {
            "w": "九重天",
            "p": "jiǔ chóng tiān"
          },
          {
            "w": "衰朽",
            "p": "shuāi xiǔ"
          }
        ],
        "keys": [
          "一封朝奏",
          "九重天",
          "夕贬潮州",
          "圣明",
          "除弊事",
          "惜残年"
        ]
      },
      {
        "text": "云横秦岭家何在？雪拥蓝关马不前。知汝远来应有意，好收吾骨瘴江边。",
        "pinyin": [
          {
            "w": "云横",
            "p": "yún héng"
          },
          {
            "w": "蓝关",
            "p": "lán guān"
          },
          {
            "w": "瘴江",
            "p": "zhàng jiāng"
          }
        ],
        "keys": [
          "云横秦岭",
          "家何在",
          "雪拥蓝关",
          "马不前",
          "瘴江边"
        ]
      }
    ]
  },
  {
    "id": "shangshanzaoxing",
    "title": "商山早行",
    "author": "温庭筠",
    "dynasty": "唐",
    "type": "poem",
    "unit": "九上 第3单元",
    "paras": [
      {
        "text": "晨起动征铎，客行悲故乡。鸡声茅店月，人迹板桥霜。",
        "pinyin": [
          {
            "w": "征铎",
            "p": "zhēng duó"
          },
          {
            "w": "茅店",
            "p": "máo diàn"
          },
          {
            "w": "板桥",
            "p": "bǎn qiáo"
          }
        ],
        "keys": [
          "晨起动",
          "征铎",
          "悲故乡",
          "鸡声茅店月",
          "人迹板桥霜"
        ]
      },
      {
        "text": "槲叶落山路，枳花明驿墙。因思杜陵梦，凫雁满回塘。",
        "pinyin": [
          {
            "w": "槲叶",
            "p": "hú yè"
          },
          {
            "w": "枳花",
            "p": "zhǐ huā"
          },
          {
            "w": "驿墙",
            "p": "yì qiáng"
          },
          {
            "w": "凫雁",
            "p": "fú yàn"
          }
        ],
        "keys": [
          "槲叶",
          "枳花",
          "驿墙",
          "杜陵梦",
          "凫雁",
          "回塘"
        ]
      }
    ]
  },
  {
    "id": "shiwucongjunzheng",
    "title": "十五从军征",
    "author": "乐府诗",
    "dynasty": "汉",
    "type": "poem",
    "unit": "九上 第6单元",
    "paras": [
      {
        "text": "十五从军征，八十始得归。道逢乡里人：“家中有阿谁？”",
        "pinyin": [
          {
            "w": "道逢",
            "p": "dào féng"
          },
          {
            "w": "阿谁",
            "p": "ā shuí"
          }
        ],
        "keys": [
          "十五从军征",
          "八十始得归",
          "道逢",
          "乡里人",
          "阿谁"
        ]
      },
      {
        "text": "“遥看是君家，松柏冢累累。”兔从狗窦入，雉从梁上飞。",
        "pinyin": [
          {
            "w": "冢累累",
            "p": "zhǒng lěi lěi"
          },
          {
            "w": "狗窦",
            "p": "gǒu dòu"
          },
          {
            "w": "雉",
            "p": "zhì"
          }
        ],
        "keys": [
          "遥看",
          "松柏冢累累",
          "狗窦",
          "梁上飞"
        ]
      },
      {
        "text": "中庭生旅谷，井上生旅葵。舂谷持作饭，采葵持作羹。",
        "pinyin": [
          {
            "w": "旅谷",
            "p": "lǚ gǔ"
          },
          {
            "w": "旅葵",
            "p": "lǚ kuí"
          },
          {
            "w": "舂谷",
            "p": "chōng gǔ"
          }
        ],
        "keys": [
          "中庭",
          "旅谷",
          "旅葵",
          "舂谷",
          "作羹"
        ]
      },
      {
        "text": "羹饭一时熟，不知贻阿谁。出门东向看，泪落沾我衣。",
        "pinyin": [
          {
            "w": "贻",
            "p": "yí"
          },
          {
            "w": "沾我衣",
            "p": "zhān wǒ yī"
          }
        ],
        "keys": [
          "羹饭",
          "一时熟",
          "贻阿谁",
          "出门东向看",
          "泪落沾我衣"
        ]
      }
    ]
  },
  {
    "id": "baixuegesongwu",
    "title": "白雪歌送武判官归京",
    "author": "岑参",
    "dynasty": "唐",
    "type": "poem",
    "unit": "九上 第6单元",
    "paras": [
      {
        "text": "北风卷地白草折，胡天八月即飞雪。忽如一夜春风来，千树万树梨花开。",
        "pinyin": [
          {
            "w": "白草折",
            "p": "bái cǎo zhé"
          },
          {
            "w": "胡天",
            "p": "hú tiān"
          }
        ],
        "keys": [
          "北风卷地",
          "白草折",
          "胡天八月",
          "忽如一夜",
          "梨花开"
        ]
      },
      {
        "text": "散入珠帘湿罗幕，狐裘不暖锦衾薄。将军角弓不得控，都护铁衣冷难着。",
        "pinyin": [
          {
            "w": "珠帘",
            "p": "zhū lián"
          },
          {
            "w": "狐裘",
            "p": "hú qiú"
          },
          {
            "w": "锦衾薄",
            "p": "jǐn qīn bó"
          },
          {
            "w": "冷难着",
            "p": "lěng nán zhuó"
          }
        ],
        "keys": [
          "珠帘",
          "罗幕",
          "狐裘",
          "锦衾薄",
          "角弓",
          "铁衣"
        ]
      },
      {
        "text": "瀚海阑干百丈冰，愁云惨淡万里凝。中军置酒饮归客，胡琴琵琶与羌笛。",
        "pinyin": [
          {
            "w": "瀚海阑干",
            "p": "hàn hǎi lán gān"
          },
          {
            "w": "愁云惨淡",
            "p": "chóu yún cǎn dàn"
          },
          {
            "w": "羌笛",
            "p": "qiāng dí"
          }
        ],
        "keys": [
          "瀚海阑干",
          "百丈冰",
          "愁云惨淡",
          "万里凝",
          "中军置酒",
          "羌笛"
        ]
      },
      {
        "text": "纷纷暮雪下辕门，风掣红旗冻不翻。轮台东门送君去，去时雪满天山路。山回路转不见君，雪上空留马行处。",
        "pinyin": [
          {
            "w": "辕门",
            "p": "yuán mén"
          },
          {
            "w": "风掣",
            "p": "fēng chè"
          },
          {
            "w": "轮台",
            "p": "lún tái"
          }
        ],
        "keys": [
          "暮雪",
          "辕门",
          "风掣红旗",
          "轮台东门",
          "山回路转",
          "马行处"
        ]
      }
    ]
  },
  {
    "id": "nanxiangzi",
    "title": "南乡子·登京口北固亭有怀",
    "author": "辛弃疾",
    "dynasty": "宋",
    "type": "poem",
    "unit": "九上 第6单元",
    "paras": [
      {
        "text": "何处望神州？满眼风光北固楼。千古兴亡多少事？悠悠。不尽长江滚滚流。",
        "pinyin": [
          {
            "w": "北固楼",
            "p": "běi gù lóu"
          },
          {
            "w": "悠悠",
            "p": "yōu yōu"
          },
          {
            "w": "滚滚",
            "p": "gǔn gǔn"
          }
        ],
        "keys": [
          "何处望神州",
          "北固楼",
          "千古兴亡",
