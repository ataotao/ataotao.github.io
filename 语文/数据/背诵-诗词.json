          "说惶恐",
          "零丁洋",
          "叹零丁",
          "谁无死",
          "照汗青"
        ]
      }
    ]
  },
  {
    "id": "shanpoyang",
    "title": "山坡羊·潼关怀古",
    "author": "张养浩",
    "dynasty": "元",
    "type": "poem",
    "unit": "九上 第6单元",
    "paras": [
      {
        "text": "峰峦如聚，波涛如怒，山河表里潼关路。望西都，意踌躇。",
