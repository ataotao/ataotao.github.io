  },
  {
    "id": "guolingdingyang",
    "title": "过零丁洋",
    "author": "文天祥",
    "dynasty": "宋",
    "type": "poem",
    "unit": "九上 第6单元",
    "paras": [
      {
        "text": "辛苦遭逢起一经，干戈寥落四周星。山河破碎风飘絮，身世浮沉雨打萍。",
        "pinyin": [
          {
